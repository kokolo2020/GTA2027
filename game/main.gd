func _open_store(i: int) -> void:
	style_store = i
	# The fitting camera looks at you from the shop floor (in a store) or from where the camera is.
	style_cam_dir = Vector3.ZERO
	for e in ga_spots:
		if int(e[0]) == i and e.size() > 2:
			style_cam_dir = e[2]
	if style_cam_dir == Vector3.ZERO and camera != null and player != null:
		style_cam_dir = camera.global_position-player.global_position
		style_cam_dir.y = 0.0
	style_cam_dir = style_cam_dir.normalized() if style_cam_dir.length() > 0.01 else Vector3.BACK
	style_tab = String((STORES[i]["tabs"] as Array)[0]) if i >= 0 else "top"
	look_try = look.duplicate()
	if not paused:
		_toggle_menu()
	_open_panel(style_panel)
	_refresh_style()
	_stat_add("store_visits")

func _open_wardrobe() -> void:
	_open_store(-1)

func _style_close() -> void:
	if paused:
		_toggle_menu()

func _style_finish() -> void:
	# Leaving a store: keep what you own, take off anything you only tried on.
	if look_try.is_empty():
		return
	var L := look_try.duplicate()
	for cat in ["t","p","sh","h","f","r"]:
		if not _owns(cat,int(L[cat])):
			L[cat] = look[cat]
	L["a"] = int(L["a"]) & int(look_own.get("a",0))
	look = L
	look_try = {}
	_sync_old_avatar()
	_apply_look()
	_save_progress()

func _sync_old_avatar() -> void:
	# Older players' phones still read the Style Shop shirt and trouser colours.
	if int(look["tc"]) < SHIRTS.size():
		av_shirt = int(look["tc"])
	if int(look["pc"]) >= 6 and int(look["pc"]) < 6+PANTS.size():
		av_pants = int(look["pc"])-6

func _style_tabs_for() -> Array:
	if style_store >= 0:
		return STORES[style_store]["tabs"]
	return ["top","bottom","shoes","acc","relic","hair","hcol","beard","body"]

func _refresh_style() -> void:
	if style_panel == null:
		return
	var wardrobe := style_store < 0
	if wardrobe:
		style_title.text = "YOUR WARDROBE"
		style_info.text = "Change into anything you own. Colours are free. You have %s." % _money(cash)
	else:
		var S: Dictionary = STORES[style_store]
		style_title.text = String(S["name"])
		style_title.add_theme_color_override("font_color",S["col"])
		var extra := ""
		if style_tab == "relic":
			extra = "  %d relics in stock today; new stock every day." % RELIC_STOCK
		style_info.text = "%s. Tap an item to try it on, then buy it. Today's deal is 30%% off.%s You have %s." % [S["sub"],extra,_money(cash)]
	if wardrobe:
		style_title.add_theme_color_override("font_color",Color("f0bd62"))
	for c in style_tabs.get_children():
		touch_buttons.erase(c)
		c.queue_free()
	for t in _style_tabs_for():
		var b := _button(String(STYLE_TAB_NAMES[t]),_style_set_tab.bind(String(t)))
		b.custom_minimum_size = Vector2(0,44)
		b.add_theme_font_size_override("font_size",16)
		b.add_theme_stylebox_override("normal",_panel(Color("8a5a1c") if t == style_tab else Color("213d4f"),12))
		style_tabs.add_child(b)
	for c in style_list.get_children():
		for sub in c.find_children("*","Button",true,false):
			touch_buttons.erase(sub)
		if c is Button:
			touch_buttons.erase(c)
		c.queue_free()
	var L := look_try if not look_try.is_empty() else look
	var rows: Array = []   # [label, sub, index, state]
	match style_tab:
		"top","bottom","shoes","acc":
			var items := _style_items(style_tab)
			for i in items.size():
				rows.append([String(items[i]["name"]),i])
		"hair":
			for i in LK_HAIRS.size():
				rows.append([String(LK_HAIRS[i][0]),i])
		"beard":
			for i in LK_BEARDS.size():
				rows.append([String(LK_BEARDS[i][0]),i])
		"relic":
			var stock := _relic_stock()
			for i in RELICS.size():
				if stock.has(i) or _owns("r",i):
					rows.append([String(RELICS[i][0]),i])
	for e in rows:
		var i := int(e[1])
		var cat := _style_cat(style_tab)
		var owned := _owns(cat,i)
		if wardrobe and not owned and not (style_tab == "acc"):
			continue
		if wardrobe and style_tab == "acc" and not owned:
			continue
		var on := ((int(L["a"]) & (1 << i)) != 0) if style_tab == "acc" else int(L[cat]) == i
		var price := _style_price(style_tab,i)
		var deal := _style_deal(style_tab) == i and not owned
		var sub := ""
		if style_tab == "relic":
			var R: Array = RELICS[i]
			sub = "%s  ·  %s" % [String(RELIC_RARITY[int(R[2])][0]),String(R[3])]
		var price_txt := "owned" if owned else ("free" if price == 0 else _money(price))
		# A catalog card: a colour tile, the name, the price and one button.
		var tile_col := Color("3a5a6a")
		match style_tab:
			"top","bottom","shoes":
				var it: Dictionary = _style_items(style_tab)[i]
				var ck := {"top":"tc","bottom":"pc","shoes":"sc"}[style_tab] as String
				tile_col = LK_COLORS[int(L[ck])] if on else LK_COLORS[int(it.get("col",0))]
			"acc": tile_col = LK_COLORS[(i*5+int(L["tc"])+3) % LK_COLORS.size()]
			"hair","beard": tile_col = LK_HAIRC[int(L["hc"])]
			"relic": tile_col = RELICS[i][4]
		var card := PanelContainer.new()
		var cs := _panel(Color("2a4a3a") if on else Color("1b3644"),14)
		cs.content_margin_left = 8
		cs.content_margin_right = 8
		cs.content_margin_top = 8
		cs.content_margin_bottom = 8
		if on:
			cs.border_color = Color("ffd86a")
			cs.set_border_width_all(3)
		card.add_theme_stylebox_override("panel",cs)
		card.custom_minimum_size = Vector2(192,0)
		style_list.add_child(card)
		var cv := VBoxContainer.new()
		cv.add_theme_constant_override("separation",4)
		card.add_child(cv)
		var tile := PanelContainer.new()
		var ts := _panel(tile_col,10)
		tile.add_theme_stylebox_override("panel",ts)
		tile.custom_minimum_size = Vector2(0,44)
		cv.add_child(tile)
		if deal or style_tab == "relic":
			var badge := _label("-30% DEAL" if deal else String(RELIC_RARITY[int(RELICS[i][2])][0]).to_upper(),14,Color("15202b") if tile_col.get_luminance() > 0.55 else Color.WHITE)
			badge.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			tile.add_child(badge)
		var nl := _label(String(e[0]),16,Color("ffd86a") if on else (Color(RELIC_RARITY[int(RELICS[i][2])][1]) if style_tab == "relic" else Color("fff5dc")))
		nl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		nl.custom_minimum_size.x = 176
		cv.add_child(nl)
		cv.add_child(_label(price_txt,15,Color("cbd8de")))
		if sub != "":
			var sl := _label(String(RELICS[i][3]),13,Color("9fb6c3"))
			sl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			sl.custom_minimum_size.x = 176
			cv.add_child(sl)
		var txt := ""
		var c := Color("213d4f")
		if on and owned:
			txt = "TAKE OFF" if style_tab in ["acc","relic"] else "WEARING ✓"
			c = Color("2f6b3a")
		elif on:
			txt = "BUY " + _money(price)
			c = Color("c0602a") if cash >= price else Color("3a2a2a")
		elif owned:
			txt = "WEAR"
			c = Color("1f6f8b")
		else:
			txt = "TRY ON"
		var b := _button(txt,_style_pick.bind(style_tab,i))
		b.custom_minimum_size = Vector2(176,42)
		b.add_theme_font_size_override("font_size",16)
		b.add_theme_stylebox_override("normal",_panel(c,12))
		cv.add_child(b)
	style_list.columns = 1 if style_tab == "body" else 3
	if style_tab == "body":
		_style_body_rows(L)
	# Colour swatches for the slot you are looking at.
	for c in style_swatches.get_children():
		touch_buttons.erase(c)
		c.queue_free()
	var ckey: String = {"top":"tc","bottom":"pc","shoes":"sc","hcol":"hc","hair":"hc"}.get(style_tab,"")
	style_swatches.visible = ckey != ""
	if ckey != "":
		var pal: Array = LK_HAIRC if ckey == "hc" else LK_COLORS
		for k in pal.size():
			var sw := _button("✓" if int(L[ckey]) == k else "",_style_color.bind(String(ckey),k))
			sw.custom_minimum_size = Vector2(56,40)
			sw.add_theme_font_size_override("font_size",18)
			sw.add_theme_color_override("font_color",Color("15202b") if (pal[k] as Color).get_luminance() > 0.5 else Color.WHITE)
			sw.add_theme_stylebox_override("normal",_panel(pal[k],10))
			sw.add_theme_stylebox_override("hover",_panel((pal[k] as Color).lightened(0.15),10))
			style_swatches.add_child(sw)
	if style_panel.visible:
		style_panel.reset_size()
		_layout_panels()

func _style_body_rows(L: Dictionary) -> void:
	# Build, skin tone and eye colour: free to change.
	for e in [["Build","b",LK_BUILDS.size()],["Skin tone","s",LK_SKINS.size()],["Eye colour","e",LK_EYES.size()]]:
		var row := HBoxContainer.new()
		row.add_theme_constant_override("separation",8)
		style_list.add_child(row)
		var key := String(e[1])
		var val := int(L[key])
		var name := String(LK_BUILDS[val]) if key == "b" else "%d of %d" % [val+1,int(e[2])]
		var lab := _label("%s: %s" % [e[0],name],17,Color("fff5dc"))
		lab.custom_minimum_size.x = 300
		row.add_child(lab)
		for st in [-1,1]:
			var b := _button("◀" if st < 0 else "▶",_style_step.bind(key,int(st),int(e[2])))
			b.custom_minimum_size = Vector2(90,44)
			row.add_child(b)

func _style_set_tab(t: String) -> void:
	style_tab = t
	_refresh_style()

func _style_step(key: String, st: int, n: int) -> void:
	look_try[key] = posmod(int(look_try[key])+st,n)
	_apply_look()
	_refresh_style()

func _style_color(key: String, k: int) -> void:
	look_try[key] = k
	_apply_look()
	_refresh_style()

func _style_pick(tab: String, i: int) -> void:
	var cat := _style_cat(tab)
	var owned := _owns(cat,i)
	if tab == "acc":
		var on := (int(look_try["a"]) & (1 << i)) != 0
		if on and owned:
			look_try["a"] = int(look_try["a"]) & ~(1 << i)
		elif on and not owned:
			if _style_buy(tab,i):
				look_own["a"] = int(look_own["a"]) | (1 << i)
				look["a"] = int(look["a"]) | (1 << i)
		else:
			look_try["a"] = int(look_try["a"]) | (1 << i)
	elif tab == "relic":
		var on := int(look_try["r"]) == i
		if on and owned:
			look_try["r"] = -1
		elif on and not owned:
			if _style_buy(tab,i):
				look_own["r"] = int(look_own["r"]) | (1 << i)
				look["r"] = i
				_ach_relics_check()
		else:
			look_try["r"] = i
	else:
		var on := int(look_try[cat]) == i
		if on and not owned:
			if _style_buy(tab,i):
				look_own[cat] = int(look_own[cat]) | (1 << i)
				look[cat] = i
		else:
			look_try[cat] = i
	_apply_look()
	_refresh_style()

func _style_buy(tab: String, i: int) -> bool:
	var price := _style_price(tab,i)
	var name := ""
	match tab:
		"hair": name = String(LK_HAIRS[i][0])
		"beard": name = String(LK_BEARDS[i][0])
		"relic": name = String(RELICS[i][0])
		_: name = String(_style_items(tab)[i]["name"])
	if tab == "relic" and not _relic_stock().has(i):
		_show_toast("%s is sold out today. New stock comes in tomorrow!" % name)
		return false
	if cash < price:
		_show_toast("%s costs %s (you have %s)." % [name,_money(price),_money(cash)])
		return false
	cash -= price
	_stat_add("style_buys")
	_show_toast("Bought %s for %s!" % [name,_money(price)])
	if not ("--smoke-test" in OS.get_cmdline_user_args()):
		_play_coin()
	_save_progress()
	return true

func _ach_relics_check() -> void:
	var n := _bits(int(look_own.get("r",0)))
	if n == 1:
		_feed_add("Your first relic! Collect more at Relic & Curio.","")

func _style_face_camera() -> void:
	# While you shop, you turn to face the camera so you can see your outfit.
	if style_panel == null or not style_panel.visible or player == null or camera == null:
		return
	# Frame yourself on the left of the screen, with the store panel on the right.
	var f := style_cam_dir
	var right := Vector3(-f.z,0,f.x)
	var head := player.global_position+Vector3(0,0.35,0)
	camera.global_position = head+f*3.1+Vector3(0,0.55,0)-right*0.0
	camera.look_at(head-right*1.15+Vector3(0,-0.15,0))
	player.rotation.y = lerp_angle(player.rotation.y,atan2(-f.x,-f.z),0.3)

# ---------------- HARBOR GALLERIA: the shopping mall ----------------
# North of the city between the Biosphere and the airport. A glass-roofed promenade runs north from
# an arch on the city's north road, with Thread & Co. (clothes) and Shear Bliss (salon) on the west
# side, Glint (accessories) and a cafe on the east, and Relic & Curio at the north end.
const GA_C := Vector3(-330,0,-600)
const GA_Z0 := -545.0          # south arch
const GA_Z1 := -652.0          # north end
const GA_W := 12.0             # promenade width
# v0.40.1: the mall is one closed building. Outer walls on these lines; the only ways in or out are
# the main entrance under the arch (south) and the Sky Run door (west).
const GA_X0 := -356.0
const GA_X1 := -304.0
const GA_ZN := -653.0
const GA_DOOR_S := 4.4          # half-width of the main entrance
const GA_DOOR_W := Vector2(-590.0,2.2)   # west door: z centre, half-width
const GA_WALL_H := 9.3
# Store fronts: [store index (-1 = cafe), centre, facing (direction from the store to the promenade)]
# v0.41: five more shops fill the gaps (the west middle stays open for the Sky Run door).
const GA_EXTRA := [
	[{"name":"SNEAKER LAB","sub":"Shoes and kicks","col":Color("e07a4a"),"act":"shoes"},Vector3(-312,0,-590),Vector3(-1,0,0)],
	[{"name":"NEON OUTFITTERS","sub":"Visors, halos, jetpacks","col":Color("4fb8d8"),"act":"gear"},Vector3(-348,0,-553.5),Vector3(1,0,0)],
	[{"name":"PET PALACE","sub":"Robot pets","col":Color("d8b84a"),"act":"pets"},Vector3(-312,0,-553.5),Vector3(-1,0,0)],
	[{"name":"SEED & BLOOM","sub":"Sky Garden seeds","col":Color("6fb86a"),"act":"seeds"},Vector3(-348,0,-636),Vector3(1,0,0)],
	[{"name":"HARBOR SWEETS","sub":"Ice cream and cakes","col":Color("d886a8"),"act":""},Vector3(-312,0,-636),Vector3(-1,0,0)],
]
var ga_extra_spots: Array = []
const GA_STORES := [[0,Vector3(-348,0,-570),Vector3(1,0,0)],[1,Vector3(-348,0,-610),Vector3(1,0,0)],
	[2,Vector3(-312,0,-570),Vector3(-1,0,0)],[-1,Vector3(-312,0,-610),Vector3(-1,0,0)],[3,Vector3(-330,0,-640),Vector3(0,0,1)]]
# v0.40: a bright, chunky, toy-plastic look for the Galleria (playful hangout style).
const GA_TOY := [Color("9a6a74"),Color("a08a5a"),Color("5e7a92"),Color("66806a"),Color("776c92"),Color("9a7458")]   # v0.41: softer
var ga_root: Node3D
var ga_spots: Array = []       # [store index, where you stand to shop]
var ga_people: Array = []
var ga_nav: Dictionary = {}
const GA_WALKERS := 22

func _ga_walkable(p: Vector3) -> bool:
	# Inside the mall building, or on the walk up to the arch.
	if p.x > GA_X0+0.4 and p.x < GA_X1-0.4 and p.z > GA_ZN+0.4 and p.z < GA_Z0+0.6:
		return true
	return absf(p.x-GA_C.x) < 3.4 and p.z >= GA_Z0 and p.z < -470.0

func _ga_text(text: String, pos: Vector3, col: Color, size: int, near: float, yaw := 0.0, billboard := false) -> Label3D:
	var l := Label3D.new()
	l.text = text
	l.font_size = size
	l.pixel_size = 0.005
	l.outline_size = 5
	l.outline_modulate = Color(0.06,0.09,0.12,0.85)
	l.modulate = col
	l.position = pos
	l.rotation.y = yaw
	l.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y if billboard else BaseMaterial3D.BILLBOARD_DISABLED
	l.visibility_range_end = near
	l.visibility_range_end_margin = near*0.15
	l.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF
	ga_root.add_child(l)
	return l

func _ga_box(pos: Vector3, size: Vector3, mat: Material, solid := false, yaw := 0.0) -> MeshInstance3D:
	var m := _fc_part(ga_root,_bbox(),pos,mat,size)
	m.rotation.y = yaw
	if solid:
		var body := StaticBody3D.new()
		body.collision_mask = 0
		var sh := CollisionShape3D.new()
		var b := BoxShape3D.new()
		b.size = size
		sh.shape = b
		body.position = pos
		body.rotation.y = yaw
		body.add_child(sh)
		ga_root.add_child(body)
	return m

func _build_galleria() -> void:
	ga_root = Node3D.new()
	ga_root.name = "Galleria"
	ga_root.set_meta("static_floor",true)
	add_child(ga_root)
	var stone := _bio_mat(Color("ece6da"),0.0,0.7)
	var pave := _bio_mat(Color("d9d2c4"),0.0,0.8)
	var dark := _bio_mat(Color("1d2a33"),0.3,0.4)
	var gold := _fc_glow(Color("ffd27a"))
	# Walk from the north road to the arch, and the promenade floor with an inlaid glowing line.
	_ga_box(Vector3(GA_C.x,0.05,(-469.0+GA_Z0)/2.0),Vector3(8,0.1,GA_Z0+469.0),pave)
	_floor_note(Vector3(GA_C.x,0.05,(-469.0+GA_Z0)/2.0),Vector3(8,0.1,GA_Z0+469.0))
	var plen := GA_Z0-GA_Z1
	_ga_box(Vector3(GA_C.x,0.05,(GA_Z0+GA_Z1)/2.0),Vector3(GA_X1-GA_X0+2.0,0.1,plen+6.0),_bio_mat(Color("5a5650"),0.0,0.6))
	# Terrazzo tiles in two tones down the promenade.
	var tiles := [[],[]]
	for ix in 5:
		for iz in int(plen/2.4):
			var tp := Vector3(GA_C.x-4.8+float(ix)*2.4,0.105,GA_Z0-1.2-float(iz)*2.4)
			tiles[(ix+iz) % 2].append(Transform3D(Basis.from_scale(Vector3(2.32,0.02,2.32)),tp))
	for k in 2:
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = _bbox()
		mm.instance_count = (tiles[k] as Array).size()
		for t in (tiles[k] as Array).size():
			mm.set_instance_transform(t,tiles[k][t])
		var mi := MultiMeshInstance3D.new()
		mi.multimesh = mm
		mi.material_override = _bio_mat([Color("8e877c"),Color("78716a")][k],0.05,0.55)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		ga_root.add_child(mi)
	_floor_note(Vector3(GA_C.x,0.05,(GA_Z0+GA_Z1)/2.0),Vector3(GA_X1-GA_X0+2.0,0.1,plen+6.0))
	for sx: float in [-6.1,6.1]:
		# Chunky coloured kerbs along the promenade.
		for k in int(plen/4.0):
			_fc_part(ga_root,_bbox(),Vector3(GA_C.x+sx,0.2,GA_Z0-2.0-float(k)*4.0),_bio_mat(GA_TOY[k % GA_TOY.size()],0.0,0.25),Vector3(0.3,0.2,3.9))
	for k in 12:
		var lz := -474.0-float(k)*6.0
		if lz < GA_Z0+2.0:
			break
		for sx: float in [-4.6,4.6]:
			_fc_part(ga_root,_bcone(0.05,0.07,3.4),Vector3(GA_C.x+sx,1.7,lz),_fc_chrome())
			_fc_part(ga_root,_bsph(0.2),Vector3(GA_C.x+sx,3.45,lz),_fc_glow(Color("fff1c8")))
	# The arch.
	for sx: float in [-5.2,5.2]:
		_ga_box(Vector3(GA_C.x+sx,4.0,GA_Z0),Vector3(1.4,8.0,1.4),_bio_mat(GA_TOY[0] if sx < 0 else GA_TOY[2],0.0,0.25),true)
		_fc_part(ga_root,_bsph(1.0),Vector3(GA_C.x+sx,9.6,GA_Z0),_bio_mat(GA_TOY[1],0.0,0.25))
	_ga_box(Vector3(GA_C.x,8.3,GA_Z0),Vector3(12.2,2.0,1.6),_bio_mat(Color("8a7a5a"),0.1,0.5))
	_ga_box(Vector3(GA_C.x,7.55,GA_Z0+0.62),Vector3(11.6,0.06,0.04),gold)
	var gt := _ga_text("HARBOR GALLERIA",Vector3(GA_C.x,8.3,GA_Z0+0.62),Color("1d2a33"),96,120.0)
	gt.pixel_size = 0.011
	gt.outline_size = 0
	var gs := _ga_text("Fashion · Beauty · Accessories · Relics",Vector3(GA_C.x,9.55,GA_Z0+0.62),Color("fff1c8"),44,60.0)
	gs.pixel_size = 0.008
	# Glass canopy over the promenade on slim columns.
	var glass := _bio_glass_mat(Color("e9f6ff"),0.22)
	var steel := _bio_mat(Color("aaa396"),0.0,0.6)
	_ga_box(Vector3(GA_C.x,9.0,(GA_Z0+GA_Z1)/2.0),Vector3(GA_W+2.0,0.06,plen),glass)
	var nb := int(plen/6.0)
	for k in nb+1:
		var z := GA_Z0-float(k)*plen/float(nb)
		var bay := _bio_mat(GA_TOY[k % GA_TOY.size()],0.0,0.55)
		_ga_box(Vector3(GA_C.x,9.05,z),Vector3(GA_W+2.0,0.4,0.4),bay)
		for sx: float in [-GA_W/2.0-0.4,GA_W/2.0+0.4]:
			if k % 2 == 0:
				_ga_box(Vector3(GA_C.x+sx,4.5,z),Vector3(0.5,9.0,0.5),bay,true)
	for sx: float in [-GA_W/2.0-0.4,0.0,GA_W/2.0+0.4]:
		_ga_box(Vector3(GA_C.x+sx,9.08,(GA_Z0+GA_Z1)/2.0),Vector3(0.14,0.14,plen),steel)
	# Stores.
	for e in GA_STORES:
		_ga_store(int(e[0]),e[1],e[2])
	for e in GA_EXTRA:
		_ga_store(-2,e[1],e[2],e[0])
	# Promenade: a fountain, planters with trees, benches and a kiosk.
	var fc := Vector3(GA_C.x,0,-590.0)
	_fc_part(ga_root,_bcone(3.2,3.4,0.6),fc+Vector3(0,0.3,0),_bio_mat(GA_TOY[4],0.0,0.25))
	_bio_cyl_col_on(ga_root,fc+Vector3(0,0.3,0),3.4,0.6)
	_fc_part(ga_root,_bcone(2.9,2.9,0.06),fc+Vector3(0,0.58,0),_bio_water_mat(Color("5fc9e8")))
	_fc_part(ga_root,_bcone(0.35,0.5,2.2),fc+Vector3(0,1.4,0),_fc_pearl())
	_fc_part(ga_root,_bcone(0.9,0.6,0.25),fc+Vector3(0,2.5,0),_fc_pearl())
	_fc_part(ga_root,_bsph(0.3),fc+Vector3(0,2.9,0),_fc_glow(Color("bff6ff")))
	var trees: Array = []
	for z: float in [-556.0,-576.0,-604.0,-624.0]:
		for sx: float in [-4.2,4.2]:
			var pp := Vector3(GA_C.x+sx,0,z)
			_fc_part(ga_root,_bio_hexmesh(1.0,0.7),pp+Vector3(0,0.35,0),_bio_mat(GA_TOY[int(absf(z)+sx) % GA_TOY.size()],0.0,0.25))
			_bio_cyl_col_on(ga_root,pp+Vector3(0,0.35,0),1.05,0.7)
			trees.append(Transform3D(Basis(Vector3.UP,z*0.7+sx).scaled(Vector3.ONE*0.7),pp+Vector3(0,0.7,0)))
			_cm_bench(ga_root,Vector3(GA_C.x+sx*0.55,0,z+3.0),0.0 if sx < 0 else PI)
	_ga_models("nature_oak",trees)
	var flowers: Array = []
	for z: float in [-566.0,-614.0]:
		for sx: float in [-4.2,4.2]:
			flowers.append(Transform3D(Basis().scaled(Vector3.ONE*1.2),Vector3(GA_C.x+sx,0.1,z)))
	_ga_models("nature_bush_flower",flowers)
	# v0.44: shoppers walk the promenade, stop at windows, go into shops and sit by the fountain.
	ga_nav = _nav_area("Galleria",GA_X0-1.0,GA_ZN-1.0,GA_X1+1.0,-469.0,[Vector3(GA_C.x,0,-600.0),Vector3(GA_C.x,0,GA_Z0-3.0)],_ga_walkable)
	var fronts: Array = []
	for e in GA_STORES:
		fronts.append([e[1],e[2]])
	for e in GA_EXTRA:
		fronts.append([e[1],e[2]])
	for F in fronts:
		var c: Vector3 = F[0]
		var f: Vector3 = F[1]
		var side := Vector3(-f.z,0,f.x)
		for sd: float in [-1.0,1.0]:
			_nav_spot(ga_nav,c+f*7.4+side*sd*4.9,-f,3.0,8.0,1.0)
		_nav_spot(ga_nav,c+f*1.0+side*2.6,-f,4.0,10.0,0.6)
		_nav_spot(ga_nav,c+f*1.0-side*2.6,-side,3.0,8.0,0.4)
	for k in 6:
		var a := float(k)*TAU/6.0
		_nav_spot(ga_nav,fc+Vector3(cos(a),0,sin(a))*4.2,-Vector3(cos(a),0,sin(a)),3.0,9.0,0.5)
	for z: float in [-563.0,-617.0]:
		for sd: float in [-1.0,1.0]:
			_nav_spot(ga_nav,Vector3(GA_C.x+sd*2.4,0,z+1.2),Vector3(-sd,0,-0.4).normalized(),3.0,7.0,0.5)
	_nav_spot(ga_nav,Vector3(GA_C.x,0,-474.0),Vector3.ZERO,0.5,2.0,0.5)
	for k in GA_WALKERS:
		var W := _stroller(ga_nav,ga_root,900+k*11,k % 8 == 5)
		if not W.is_empty():
			ga_people.append(W["pp"])
	_ga_shell()
	_car_barrier([[Vector3(GA_C.x,0.9,GA_Z0+1.6),Vector3(GA_DOOR_S*2.0+1.0,1.8,0.5),0.0],[Vector3(GA_X0-1.6,0.9,GA_DOOR_W.x),Vector3(GA_DOOR_W.y*2.0+1.0,1.8,0.5),PI/2.0]])
	_build_ga_fun()
	_cull_people_in(ga_root,95.0)
	# v0.48: the mall is closed all round, so its inside is only drawn when you're in it or at a door.
	for c in ga_root.get_children():
		if c is CollisionObject3D or not (c is Node3D):
			continue
		var gp := (c as Node3D).global_position
		var inside := gp.x > GA_X0+0.5 and gp.x < GA_X1-0.5 and gp.z > GA_ZN+0.5 and gp.z < GA_Z0-1.2
		if inside or c is MultiMeshInstance3D:
			ga_inner.append(c)
	for c in ga_inner:
		ga_shell_nodes.erase(c)

var ga_inner: Array = []         # v0.48: everything inside the mall (hidden while you're away)
var ga_shell_nodes: Array = []
var ga_inner_on := true

func _ga_inner_tick() -> void:
	if ga_inner.is_empty():
		return
	var cam := get_viewport().get_camera_3d()
	if cam == null:
		return
	var p := cam.global_position
	var m := 14.0
	var on := p.x > GA_X0-m and p.x < GA_X1+m and p.z > GA_ZN-m and p.z < GA_Z0+m
	if on == ga_inner_on:
		return
	ga_inner_on = on
	for c in ga_inner:
		if is_instance_valid(c):
			(c as Node3D).visible = on

func _ga_shell() -> void:
	# Solid outer walls up to the glass roof, in the mall's toy colours, with two doorways.
	var t := 0.6
	var h := GA_WALL_H
	var white := _bio_mat(Color("aaa396"),0.0,0.6)
	var walls: Array = []   # [from, to] along one line
	var zs := GA_Z0
	# South front: either side of the main entrance.
	walls.append([Vector3(GA_X0,0,zs),Vector3(GA_C.x-GA_DOOR_S,0,zs)])
	walls.append([Vector3(GA_C.x+GA_DOOR_S,0,zs),Vector3(GA_X1,0,zs)])
	# North back.
	walls.append([Vector3(GA_X0,0,GA_ZN),Vector3(GA_X1,0,GA_ZN)])
	# East side, and the west side either side of the Sky Run door.
	walls.append([Vector3(GA_X1,0,zs),Vector3(GA_X1,0,GA_ZN)])
	walls.append([Vector3(GA_X0,0,zs),Vector3(GA_X0,0,GA_DOOR_W.x+GA_DOOR_W.y)])
	walls.append([Vector3(GA_X0,0,GA_DOOR_W.x-GA_DOOR_W.y),Vector3(GA_X0,0,GA_ZN)])
	for k in walls.size():
		var a: Vector3 = walls[k][0]
		var b: Vector3 = walls[k][1]
		var mid := (a+b)/2.0
		var along_x := absf(b.x-a.x) > absf(b.z-a.z)
		var L := (absf(b.x-a.x) if along_x else absf(b.z-a.z))+t
		var size := Vector3(L,h,t) if along_x else Vector3(t,h,L)
		_ga_box(mid+Vector3(0,h/2.0,0),size,_bio_mat(GA_TOY[(k*2+1) % GA_TOY.size()].darkened(0.15),0.0,0.6),true)
		_ga_box(mid+Vector3(0,h+0.2,0),Vector3(size.x+0.3,0.4,size.z+0.3),white)
		_ga_box(mid+Vector3(0,0.4,0),Vector3(size.x+0.2,0.8,size.z+0.2),white)
	# Roof over the store rows (the promenade keeps its glass canopy).
	for sx: float in [-1.0,1.0]:
		var cx := GA_C.x+sx*(GA_W/2.0+0.6+(absf(GA_X0-GA_C.x)-GA_W/2.0-0.6)/2.0)
		var wdt := absf(GA_X0-GA_C.x)-GA_W/2.0-0.6
		_ga_box(Vector3(cx,h,(GA_Z0+GA_ZN)/2.0),Vector3(wdt,0.3,GA_Z0-GA_ZN),_bio_mat(Color("f4f1ec"),0.0,0.6))
	_ga_box(Vector3(GA_C.x,h,(GA_Z1+GA_ZN)/2.0-0.5),Vector3(GA_W+1.2,0.3,GA_Z1-GA_ZN+1.0),_bio_mat(Color("f4f1ec"),0.0,0.6))
	# Door frames with EXIT signs.
	var green := _fc_glow(Color("4cff7a"))
	_ga_box(Vector3(GA_C.x,4.6,GA_Z0-0.4),Vector3(GA_DOOR_S*2.0,0.25,0.2),green)
	var e1 := _ga_text("ENTRANCE · EXIT",Vector3(GA_C.x,5.1,GA_Z0-0.45),Color("4cff7a"),56,30.0)
	e1.rotation.y = PI
	e1.double_sided = false
	e1.pixel_size = 0.006
	var wz := GA_DOOR_W.x
	for sz: float in [-1.0,1.0]:
		_ga_box(Vector3(GA_X0,1.6,wz+sz*(GA_DOOR_W.y+0.25)),Vector3(0.9,3.2,0.5),white,true)
	_ga_box(Vector3(GA_X0,3.35,wz),Vector3(0.9,0.5,GA_DOOR_W.y*2.0+1.0),white,true)
	for sd: float in [-1.0,1.0]:
		_ga_box(Vector3(GA_X0+sd*0.5,3.35,wz),Vector3(0.05,0.2,GA_DOOR_W.y*2.0),green)
		var ex := _ga_text("EXIT  ·  SKY RUN" if sd > 0 else "ENTRANCE",Vector3(GA_X0+sd*0.48,4.1,wz),Color("4cff7a"),50,25.0)
		ex.rotation.y = PI/2.0*sd
		ex.pixel_size = 0.006
		ex.double_sided = false

func _ga_inside(p: Vector3) -> bool:
	return p.x > GA_X0 and p.x < GA_X1 and p.z < GA_Z0 and p.z > GA_ZN

func _bio_cyl_col_on(parent: Node3D, p: Vector3, r: float, h: float) -> void:
	var body := StaticBody3D.new()
	body.collision_mask = 0
	var sh := CollisionShape3D.new()
	var cs := CylinderShape3D.new()
	cs.radius = r
	cs.height = h
	sh.shape = cs
	body.position = p
	body.add_child(sh)
	parent.add_child(body)

func _ga_models(name: String, xs: Array) -> void:
	var mesh := _bio_nature_mesh(name)
	if mesh == null or xs.is_empty():
		return
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.mesh = mesh
	mm.instance_count = xs.size()
	for k in xs.size():
		mm.set_instance_transform(k,xs[k])
	var mi := MultiMeshInstance3D.new()
	mi.multimesh = mm
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	ga_root.add_child(mi)

func _ga_lbox(n: Node3D, pos: Vector3, size: Vector3, mat: Material, solid := false) -> MeshInstance3D:
	var m := _fc_part(n,_bbox(),pos,mat,size)
	if solid:
		var body := StaticBody3D.new()
		body.collision_mask = 0
		var sh := CollisionShape3D.new()
		var b := BoxShape3D.new()
		b.size = size
		sh.shape = b
		body.position = pos
		body.add_child(sh)
		n.add_child(body)
	return m

func _ga_ltext(n: Node3D, text: String, pos: Vector3, col: Color, size: int, near: float) -> Label3D:
	var l := _ga_text(text,Vector3.ZERO,col,size,near)
	ga_root.remove_child(l)
	n.add_child(l)
	l.position = pos
	return l

func _ga_store(si: int, c: Vector3, face: Vector3, X := {}) -> void:
	# A store in its own frame: local +z faces the promenade, x runs along the front.
	# 16 m wide, 12 m deep, a two-storey facade with a door and display windows.
	var W := 16.0
	var D := 12.0
	var H := 7.0
	var n := Node3D.new()
	n.position = c
	n.rotation.y = atan2(face.x,face.z)
	ga_root.add_child(n)
	var S: Dictionary = STORES[si] if si >= 0 else ({"name":"HARBOR BREW","sub":"Coffee and cakes","col":Color("e0a060")} if X.is_empty() else X)
	var accent: Color = S["col"]
	var wall := _bio_mat(accent.darkened(0.25).lerp(Color("8a8278"),0.35),0.0,0.6)
	var floor_m := _bio_mat([Color("8a6a4a"),Color("5a4868"),Color("2a3a48"),Color("2a2230"),Color("7a5a3e")][si if si >= 0 else 4],0.1,0.35)
	var inner := _bio_mat(accent.darkened(0.55),0.0,0.7)
	var wood := _bio_mat(Color("9a6a42"),0.0,0.55)
	var fz := D/2.0
	_ga_lbox(n,Vector3(0,0.11,0),Vector3(W,0.02,D),floor_m)
	_ga_lbox(n,Vector3(0,H/2.0,-D/2.0),Vector3(W,H,0.4),wall,true)
	_ga_lbox(n,Vector3(0,2.6,-D/2.0+0.22),Vector3(W-1.0,5.2,0.04),inner)
	for sd: float in [-1.0,1.0]:
		_ga_lbox(n,Vector3(sd*W/2.0,H/2.0,0),Vector3(0.4,H,D),wall,true)
		_ga_lbox(n,Vector3(sd*(W/2.0-0.22),2.6,0),Vector3(0.04,5.2,D-1.0),inner)
		# Wood cladding on the facade either side of the windows.
		_ga_lbox(n,Vector3(sd*(W/2.0-0.15),3.5,fz+0.35),Vector3(0.9,7.0,0.5),_bio_mat(Color("aaa396"),0.0,0.6))
	_ga_lbox(n,Vector3(0,H,0),Vector3(W+0.4,0.3,D+0.4),wall)
	_ga_lbox(n,Vector3(0,H-0.2,0),Vector3(W-1.0,0.06,D-1.0),_fc_glow(Color("fff6e0")))
	# Facade: pillars by the door, glass windows on low sills either side, a dark sign band.
	for sd: float in [-1.0,1.0]:
		var wx := sd*(W/4.0+0.95)
		var ww := W/2.0-1.9
		_ga_lbox(n,Vector3(wx,0.35,fz),Vector3(ww,0.7,0.5),wall,true)
		var win := _ga_lbox(n,Vector3(wx,2.2,fz),Vector3(ww,3.0,0.08),_bio_glass_mat(Color("dff3ff"),0.22),true)
		win.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		_ga_lbox(n,Vector3(wx,3.75,fz),Vector3(ww,0.1,0.1),_fc_glow(accent))
		_ga_lbox(n,Vector3(sd*1.9,2.6,fz),Vector3(0.7,5.2,0.7),_bio_mat(Color("b8935a"),0.1,0.5),true)
	_ga_lbox(n,Vector3(0,5.6,fz+0.1),Vector3(W+0.6,2.9,0.9),_bio_mat(Color("2a2f36"),0.1,0.5),true)
	var nm := _ga_ltext(n,String(S["name"]),Vector3(0,5.95,fz+0.57),accent.lightened(0.25),120,70.0)
	nm.outline_size = 0
	var sb := _ga_ltext(n,String(S["sub"]),Vector3(0,5.0,fz+0.57),Color("e4ddd0"),46,40.0)
	sb.outline_size = 0
	# A chunky striped awning over the door.
	for k in 5:
		_ga_lbox(n,Vector3(-2.0+float(k)*1.0,4.0,fz+1.1),Vector3(1.0,0.25,2.2),_bio_mat(accent.darkened(0.1) if k % 2 == 0 else Color("e4ddd0"),0.0,0.6))
	# Inside: a counter at the back, the shop assistant behind it, and where you stand to shop.
	var cz := -D/2.0+2.4
	_ga_lbox(n,Vector3(0,0.55,cz),Vector3(4.2,1.1,1.0),_fc_pearl(),true)
	_ga_lbox(n,Vector3(0,1.12,cz),Vector3(4.4,0.06,1.2),_bio_mat(accent.darkened(0.3),0.2,0.4))
	var clerk := _cm_person(n,Vector3(0,0,cz-1.0),0.0,700+maxi(si,4)+si)
	if not clerk.is_empty():
		ga_people.append(clerk)
	if si >= 0:
		ga_spots.append([si,n.transform*Vector3(0,0,cz+1.4),n.transform.basis*Vector3(0,0,1)])
	elif String(X.get("act","")) != "":
		ga_extra_spots.append([String(X["act"]),n.transform*Vector3(0,0,cz+1.4),String(X["name"])])
		var ring2 := _fc_part(n,_fc_torus(0.75,0.95),Vector3(0,0.14,cz+1.4),_fc_glow(accent))
		ring2.scale = Vector3(1,0.3,1)
		for sd: float in [-1.0,1.0]:
			for k in 3:
				_ga_lbox(n,Vector3(sd*(W/2.0-1.0),0.6+float(k)*0.8,-1.0),Vector3(0.6,0.06,5.0),_bio_mat(Color("8a6a4a"),0.0,0.6))
				for j in 5:
					_ga_lbox(n,Vector3(sd*(W/2.0-1.0),0.8+float(k)*0.8,-3.0+float(j)*1.0),Vector3(0.35,0.3,0.35),_bio_mat(GA_TOY[(j+k) % GA_TOY.size()],0.0,0.5))
		var ring := _fc_part(n,_fc_torus(0.75,0.95),Vector3(0,0.14,cz+1.4),_fc_glow(accent))
		ring.scale = Vector3(1,0.3,1)
	match si:
		0:
			for sd: float in [-1.0,1.0]:
				for k in 3:
					var rx := sd*(W/2.0-1.0)
					var rz := -3.4+float(k)*2.6
					_ga_lbox(n,Vector3(rx,1.75,rz),Vector3(0.06,0.06,2.0),_fc_chrome())
					for h in 5:
						var hc: Color = LK_COLORS[(k*5+h+int(sd+1.0)*3) % LK_COLORS.size()]
						_ga_lbox(n,Vector3(rx,1.15,rz-0.8+float(h)*0.4),Vector3(0.55,0.95,0.06),_bio_mat(hc,0.0,0.8))
			_ga_mannequins(n,fz-1.2,[{"t":7,"tc":16,"p":0,"pc":5,"sh":2,"sc":14,"h":4},{"t":6,"tc":11,"sh":1,"sc":15,"h":9,"hc":5},{"t":10,"tc":6,"pc":5,"sh":3,"sc":14,"h":8},{"t":5,"tc":8,"p":2,"pc":5,"sh":1,"sc":2,"h":5}])
		1:
			for k in 3:
				var cx := -4.5+float(k)*4.5
				_ga_lbox(n,Vector3(cx,0.45,-0.5),Vector3(0.7,0.9,0.7),_bio_mat(Color("c88bff"),0.1,0.5),true)
				_ga_lbox(n,Vector3(cx,1.7,-1.6),Vector3(0.9,1.3,0.06),_bio_glass_mat(Color("e9f6ff"),0.6))
			_ga_mannequins(n,fz-1.2,[{"h":5,"hc":1,"s":5},{"h":6,"hc":3,"s":2},{"h":7,"hc":8,"s":0},{"h":9,"hc":6,"s":1}],true)
		2:
			for k in 4:
				var cx := -5.0+float(k)*3.3
				_ga_lbox(n,Vector3(cx,0.5,0),Vector3(1.0,1.0,1.0),_fc_pearl(),true)
				_ga_lbox(n,Vector3(cx,1.25,0),Vector3(0.95,0.5,0.95),_bio_glass_mat(Color("dff3ff"),0.3))
				_fc_part(n,_bsph(0.09),Vector3(cx,1.1,0),_fc_glow([Color("ffd23f"),Color("4fe3ff"),Color("ff7ab8"),Color("c0c8d0")][k]))
			_ga_mannequins(n,fz-1.2,[{"a":(1 << 1)|(1 << 7),"t":9,"tc":5,"h":8},{"a":(1 << 5)|(1 << 4),"t":0,"tc":15,"h":9,"hc":5},{"a":(1 << 3)|(1 << 0),"t":5,"tc":1,"h":3},{"a":(1 << 6)|(1 << 2),"t":4,"tc":10,"h":1,"hc":4}],true)
		3:
			for k in 6:
				var cx := -5.0+float(k % 3)*5.0
				var cz2 := -1.0+float(k/3)*3.2
				_ga_lbox(n,Vector3(cx,0.5,cz2),Vector3(0.9,1.0,0.9),_bio_mat(Color("3a2a4a"),0.3,0.4),true)
				var rel := _relic_model([8,9,10,13,14,15][k])
				rel.position = Vector3(cx,1.35,cz2)
				rel.scale = Vector3.ONE*2.2
				n.add_child(rel)
				_ga_lbox(n,Vector3(cx,1.4,cz2),Vector3(0.85,0.8,0.85),_bio_glass_mat(Color("fff1c8"),0.18))
		_:
			for k in 3:
				_bio_cafe_on(n,Vector3(-4.0+float(k)*4.0,0,1.0),k)

func _bio_cafe_on(n: Node3D, p: Vector3, seed_i: int) -> void:
	var wood := Color("8a5a36")
	_fc_part(n,_bcone(0.45,0.45,0.05),p+Vector3(0,0.75,0),_bio_mat(Color("f6f3ec"),0.0,0.6))
	_fc_part(n,_bcone(0.04,0.04,0.75),p+Vector3(0,0.37,0),_fc_chrome())
	for k in 3:
		var a := float(k)*TAU/3.0+float(seed_i)
		_fc_part(n,_bbox(),p+_bio_dir(a)*0.8+Vector3(0,0.45,0),_bio_mat(wood,0.0,0.6),Vector3(0.42,0.06,0.42))

func _ga_mannequins(n: Node3D, z: float, looks: Array, heads := false) -> void:
	# Mannequins in the shop windows (white, or with real faces in the salon), wearing what the store sells.
	for k in looks.size():
		var x: float = [-6.2,-3.6,3.6,6.2][k % 4]
		_fc_part(n,_bcone(0.4,0.45,0.15),Vector3(x,0.08,z),_fc_pearl())
		var m := Node3D.new()
		m.position = Vector3(x,0.15,z)
		m.rotation.y = 0.3 if k % 2 == 0 else -0.3
		n.add_child(m)
		var pp := _make_person(m,0,{"Shirt":Color.WHITE,"Pants":Color.WHITE,"Skin":Color.WHITE,"Hair":Color.WHITE,"Shoes":Color.WHITE,"Eye":Color.BLACK},true)
		var L := {}
		for key in LOOK_KEYS:
			L[key] = 0
		L["r"] = -1
		L["pc"] = 6
		L["sc"] = 15
		for key in looks[k]:
			L[key] = looks[k][key]
		_dress(pp,L)
		if not heads:
			(pp["mats"]["Skin"] as StandardMaterial3D).albedo_color = Color("f2f2f0")
			(pp["mats"]["Eye"] as StandardMaterial3D).albedo_color = Color("f2f2f0")
			(pp["mats"]["Hair"] as StandardMaterial3D).albedo_color = Color("f2f2f0")
		_pose_person(pp,0.0,0.0)

# ---------------- featured outfits and the Sky Run ----------------
# Two spinning podiums on the promenade show today's featured outfits (new every day). Beside the
# mall, the Sky Run: bounce pads launch you from platform to platform up to a prize at the top
# (once a day). There is no jump button in Harbor City, so the pads do the jumping.
const SKY_PADS := [[Vector3(-364,0,-590),0.0],[Vector3(-369,0,-595),3.5],[Vector3(-375,0,-599),7.0],[Vector3(-381,0,-595),10.5],[Vector3(-386,0,-589),14.0],[Vector3(-381,0,-583),17.5]]
const SKY_PAY := 300
const SKY_XP := 60
var ga_spin: Array = []
var sky_day := ""
var sky_best := 0.0
var sky_t := -1.0
var sky_cool := 0.0

func _ga_featured_look(k: int) -> Dictionary:
	var r := RandomNumberGenerator.new()
	r.seed = hash("featured-%d-%s" % [k,_style_today()])
	var L := {}
	for key in LOOK_KEYS:
		L[key] = 0
	L["r"] = -1
	L["b"] = r.randi() % 3
	L["s"] = r.randi() % LK_SKINS.size()
	L["h"] = 4+r.randi() % 6
	L["hc"] = r.randi() % LK_HAIRC.size()
	L["t"] = 4+r.randi() % (LK_TOPS.size()-4)
	L["tc"] = r.randi() % LK_COLORS.size()
	L["p"] = r.randi() % LK_BOTTOMS.size()
	L["pc"] = r.randi() % LK_COLORS.size()
	L["sh"] = 1+r.randi() % (LK_SHOES.size()-1)
	L["sc"] = r.randi() % LK_COLORS.size()
	L["a"] = (1 << (r.randi() % LK_ACCS.size())) | (1 << (r.randi() % LK_ACCS.size()))
	L["r"] = r.randi() % RELICS.size()
	return L

func _build_ga_fun() -> void:
	for k in 2:
		var p := Vector3(GA_C.x,0,[-563.0,-617.0][k])
		_fc_part(ga_root,_bcone(1.25,1.35,0.5),p+Vector3(0,0.25,0),_bio_mat(GA_TOY[k*2+1],0.0,0.25))
		_bio_cyl_col_on(ga_root,p+Vector3(0,0.25,0),1.35,0.5)
		var ring := _fc_part(ga_root,_fc_torus(1.25,1.4),p+Vector3(0,0.5,0),_fc_glow(GA_TOY[k*2+2]))
		ring.scale = Vector3(1,0.4,1)
		var spin := Node3D.new()
		spin.position = p+Vector3(0,0.5,0)
		ga_root.add_child(spin)
		ga_spin.append(spin)
		var pp := _make_person(spin,0,{"Shirt":Color.WHITE,"Pants":Color.WHITE,"Skin":Color.WHITE,"Hair":Color.WHITE,"Shoes":Color.WHITE,"Eye":Color.BLACK},true)
		var L := _ga_featured_look(k)
		_dress(pp,L)
		_pose_person(pp,0.0,0.0)
		var rel := _relic_model(int(L["r"]))
		rel.position = Vector3(0.55,1.45,0.15)
		spin.add_child(rel)
		var t := _ga_text("FEATURED TODAY",p+Vector3(0,2.45,0),GA_TOY[k*2+1].lightened(0.2),44,25.0,0.0,true)
		t.pixel_size = 0.006
	# The Sky Run.
	for k in SKY_PADS.size():
		var c: Vector3 = SKY_PADS[k][0]
		var top: float = SKY_PADS[k][1]
		var col: Color = GA_TOY[k % GA_TOY.size()]
		if k > 0:
			var sz := 5.0 if k == SKY_PADS.size()-1 else 3.6
			_ga_box(c+Vector3(0,top-0.25,0),Vector3(sz,0.5,sz),_bio_mat(col,0.0,0.25),true)
			_ga_box(c+Vector3(0,top-0.55,0),Vector3(sz-0.4,0.1,sz-0.4),_fc_glow(col.lightened(0.3)))
		if k < SKY_PADS.size()-1:
			_fc_part(ga_root,_bcone(0.9,0.95,0.12),c+Vector3(0,top+0.06,0),_bio_mat(Color("ffffff"),0.0,0.2))
			var pad := _fc_part(ga_root,_fc_torus(0.55,0.85),c+Vector3(0,top+0.13,0),_fc_glow(Color("4fe3ff")))
			pad.scale = Vector3(1,0.4,1)
			var arrow := _fc_part(ga_root,_bcone(0.0,0.3,0.4),c+Vector3(0,top+0.5,0),_fc_glow(Color("4fe3ff")))
			ga_spin.append(arrow)
	var fin: Vector3 = SKY_PADS[SKY_PADS.size()-1][0]
	var ft: float = SKY_PADS[SKY_PADS.size()-1][1]
	_ga_box(fin+Vector3(0,ft+0.4,-1.6),Vector3(1.2,0.8,0.8),_bio_mat(Color("c0602a"),0.0,0.4))
	_ga_box(fin+Vector3(0,ft+0.85,-1.6),Vector3(1.25,0.15,0.85),_fc_glow(Color("ffd23f")))
	_fc_part(ga_root,_bcone(0.05,0.05,3.0),fin+Vector3(1.8,ft+1.5,-1.8),_fc_chrome())
	_ga_box(fin+Vector3(2.3,ft+2.7,-1.8),Vector3(1.0,0.6,0.05),_bio_mat(GA_TOY[0],0.0,0.25))
	var st := _ga_text("SKY RUN",SKY_PADS[0][0]+Vector3(0,2.6,0),Color("ffc83d"),80,40.0,0.0,true)
	st.pixel_size = 0.008
	_ga_text("Step on the pads. Prize at the top, once a day!",SKY_PADS[0][0]+Vector3(0,2.0,0),Color("ffffff"),32,20.0,0.0,true).pixel_size = 0.006

func _ga_fun_tick(delta: float) -> void:
	if not place_open[0]:
		return
	for n in ga_spin:
		(n as Node3D).rotation.y += delta*0.8
	if player == null or driving or paused or ga_root == null:
		return
	sky_cool -= delta
	if sky_t >= 0.0:
		sky_t += delta
	if player.position.distance_to(SKY_PADS[2][0]) > 40.0:
		return
	var feet := player.position.y-0.7
	for k in SKY_PADS.size()-1:
		var c: Vector3 = SKY_PADS[k][0]
		var top: float = SKY_PADS[k][1]
		if Vector2(player.position.x-c.x,player.position.z-c.z).length() < 0.95 and absf(feet-top) < 0.35 and player.velocity.y <= 0.5 and sky_cool <= 0.0:
			var nxt: float = SKY_PADS[k+1][1]
			player.velocity.y = sqrt(2.0*24.0*(nxt-top+2.0))
			sky_cool = 0.4
			if k == 0:
				sky_t = 0.0
	var fin: Vector3 = SKY_PADS[SKY_PADS.size()-1][0]
	var ft: float = SKY_PADS[SKY_PADS.size()-1][1]
	if sky_t >= 0.0 and absf(feet-ft) < 0.4 and Vector2(player.position.x-fin.x,player.position.z-fin.z).length() < 2.6:
		_sky_finish()

func _sky_finish() -> void:
	var t := sky_t
	sky_t = -1.0
	var best := sky_best <= 0.0 or t < sky_best
	if best:
		sky_best = t
	if sky_day != _style_today():
		sky_day = _style_today()
		var mult := 3 if _harbor_night() and pass_test_now == 0 and not ("--smoke-test" in OS.get_cmdline_user_args()) else 1
		cash += SKY_PAY*mult
		bonus_xp += SKY_XP
		_show_toast("SKY RUN COMPLETE in %.1f s!  +$%d  +%d XP%s%s" % [t,SKY_PAY*mult,SKY_XP,"  New best!" if best else "","  (Harbor Night x3!)" if mult > 1 else ""])
		_feed_add("Sky Run: +$%d" % SKY_PAY,"")
		if not ("--smoke-test" in OS.get_cmdline_user_args()):
			_play_coin()
	else:
		_show_toast("Sky Run in %.1f s%s  (best %.1f s). The prize comes back tomorrow." % [t,"  New best!" if best else "",sky_best])
	_save_progress()

func _extra_near() -> int:
	if driving or player == null or paused or not place_open[0]:
		return -1
	for i in ga_extra_spots.size():
		var p: Vector3 = ga_extra_spots[i][1]
		if Vector2(player.position.x-p.x,player.position.z-p.z).length() < 2.4:
			return i
	return -1

func _extra_open(i: int) -> void:
	match String(ga_extra_spots[i][0]):
		"shoes":
			_open_store(0)
			_style_set_tab("shoes")
		"gear": _open_market(0)
		"pets": _open_market(1)
		"seeds": _sg_open("shop",-1)

func _store_near() -> int:
	if driving or player == null or paused or not place_open[0]:
		return -1
	for e in ga_spots:
		var p: Vector3 = e[1]
		if Vector2(player.position.x-p.x,player.position.z-p.z).length() < 2.4:
			return int(e[0])
	return -1

# ---------- v0.41: THE SKY GARDEN ----------
# A raised garden terrace west of the Galleria, by the Sky Run. Buy exotic seeds at the Seed Stall
# (new stock every 20 minutes), plant them in your eight beds and come back: they grow in real time,
# even while the game is closed. Rarer plants take longer and sell for more. Some sprout a mutation
# (Giant, Golden or Rainbow) worth 2x, 3x or 10x. Every plant you grow fills your Garden Codex.
# Plants never wither, and every chance is shown on screen.
const SG_C := Vector3(-402,0,-636)
const SG_TOP := 3.0
const SG_X0 := -415.0
const SG_X1 := -389.0
const SG_Z0 := -628.0          # south edge (the ramp comes up here)
const SG_Z1 := -644.0
const SG_RAMP_X := -403.0
const SG_RESTOCK := 1200       # seconds between Seed Stall restocks
# [name, rarity, seed price, grow seconds, sell value, colour A, colour B, shape]
const SG_PLANTS := [
	["Sunburst Daisy",0,20,120,45,Color("ffd23f"),Color("ff8a1c"),"daisy"],
	["Fire Lily",0,40,300,100,Color("ff4f3a"),Color("ffb347"),"lily"],
	["Ghost Fern",1,90,600,220,Color("bfefff"),Color("7fd6c8"),"fern"],
	["Crystal Cactus",1,150,900,380,Color("6fd3ff"),Color("3f9a6a"),"cactus"],
	["Glow Orchid",2,300,1800,800,Color("c254ff"),Color("ff7ab8"),"orchid"],
	["Venus Snapper",2,450,2700,1200,Color("5fbf3a"),Color("d8392b"),"snapper"],
	["Dragonfruit Vine",3,900,5400,2600,Color("ff3f8f"),Color("4fae4a"),"vine"],
	["Star Lotus",3,1400,7200,4200,Color("fff1c8"),Color("ff9ad0"),"lotus"],
	["Golden Bamboo",4,3000,14400,9500,Color("ffcf4a"),Color("b88a2a"),"bamboo"],
	["Celestial Rose",4,5000,21600,16000,Color("8a5bff"),Color("4fe3ff"),"rose"],
	["Moonbloom Tree",5,12000,43200,42000,Color("e9f6ff"),Color("9fd8ff"),"tree"],
	["Phoenix Palm",5,20000,86400,75000,Color("ff6a1c"),Color("ffd23f"),"palm"],
]
const SG_RARITY := [["Common",Color("cbd8de"),1.0,6],["Uncommon",Color("7dff9a"),0.7,3],["Rare",Color("6fd3ff"),0.4,2],["Epic",Color("c88bff"),0.18,1],["Legendary",Color("ffcf4a"),0.06,1],["Mythic",Color("ff7ab8"),0.02,1]]
# Mutations: [name, value multiplier, chance]
const SG_MUTS := [["",1,0.0],["Giant",2,0.08],["Golden",3,0.06],["Rainbow",10,0.01]]
const SG_ALL_PAY := 5000
var sg_root: Node3D
var sg_plots: Array = []        # per bed: [seed, planted unix time, mutation] (seed -1 = empty)
var sg_bag := {0:3}             # seed index -> count (three free daisies to start)
var sg_codex := 0               # bit per plant grown
var sg_mutseen := 0             # bit per mutation found
var sg_all_done := false
var sg_bought := {}             # this restock: seed index -> bought
var sg_bought_key := -1
var sg_test_now := 0
var sg_nodes: Array = []        # per bed: {"node","plant","spark","label","key"}
var sg_beds: Array = []         # bed centres
var sg_rainbow: StandardMaterial3D
var sg_tick_t := 0.0
var sg_panel: PanelContainer
var sg_title: Label
var sg_info: Label
var sg_list: VBoxContainer
var sg_mode := "shop"
var sg_plot_sel := -1
var sg_told := false

func _sg_now() -> int:
	return sg_test_now if sg_test_now > 0 else int(Time.get_unix_time_from_system())

func _sg_progress(p: int) -> float:
	var P: Array = sg_plots[p]
	if int(P[0]) < 0:
		return 0.0
	return clampf(float(_sg_now()-int(P[1]))/float(SG_PLANTS[int(P[0])][3]),0.0,1.0)

func _sg_time(sec: int) -> String:
	if sec >= 3600:
		return "%dh %02dm" % [sec/3600,(sec % 3600)/60]
	if sec >= 60:
		return "%dm %02ds" % [sec/60,sec % 60]
	return "%ds" % sec

func _sg_stock() -> Array:
	# This restock's seeds: [seed, how many]. Commons always; rarer seeds turn up by chance.
	var key := _sg_now()/SG_RESTOCK
	if key != sg_bought_key:
		sg_bought_key = key
		sg_bought = {}
	var r := RandomNumberGenerator.new()
	r.seed = hash("sky-garden-%d" % key)
	var out: Array = []
	for i in SG_PLANTS.size():
		var R: Array = SG_RARITY[int(SG_PLANTS[i][1])]
		if r.randf() < float(R[2]):
			out.append([i,int(R[3])])
	return out

func _sg_mut_roll(t: int, p: int, night := false) -> int:
	var r := RandomNumberGenerator.new()
	r.seed = hash("sg-mut-%d-%d" % [t,p])
	var x := r.randf()*(0.5 if night else 1.0)   # v0.43: Harbor Night doubles every mutation chance
	if x < float(SG_MUTS[3][2]):
		return 3
	if x < float(SG_MUTS[3][2])+float(SG_MUTS[2][2]):
		return 2
	if x < float(SG_MUTS[3][2])+float(SG_MUTS[2][2])+float(SG_MUTS[1][2]):
		return 1
	return 0

# ---------------- building ----------------
func _sg_box(pos: Vector3, size: Vector3, mat: Material, solid := false) -> MeshInstance3D:
	var m := _fc_part(sg_root,_bbox(),pos,mat,size)
	if solid:
		_collider(sg_root,pos,size)
	return m

func _sg_text(text: String, pos: Vector3, col: Color, size: int, near: float) -> Label3D:
	var l := Label3D.new()
	l.text = text
	l.font_size = size
	l.pixel_size = 0.005
	l.outline_size = 5
	l.outline_modulate = Color(0.06,0.09,0.12,0.85)
	l.modulate = col
	l.position = pos
	l.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	l.visibility_range_end = near
	sg_root.add_child(l)
	return l

func _build_sky_garden() -> void:
	sg_root = Node3D.new()
	sg_root.name = "SkyGarden"
	add_child(sg_root)
	sg_rainbow = StandardMaterial3D.new()
	sg_rainbow.emission_enabled = true
	sg_rainbow.emission_energy_multiplier = 0.6
	var W := SG_X1-SG_X0
	var D := SG_Z0-SG_Z1
	var cx := (SG_X0+SG_X1)/2.0
	var cz := (SG_Z0+SG_Z1)/2.0
	# The terrace: a stone block with a green vine band, a wooden deck and a low railing.
	_sg_box(Vector3(cx,SG_TOP/2.0,cz),Vector3(W,SG_TOP,D),_bio_mat(Color("e9e2d4"),0.0,0.7),true)
	_sg_box(Vector3(cx,SG_TOP-0.35,cz),Vector3(W+0.1,0.5,D+0.1),_bio_mat(Color("4f9a45"),0.0,0.8))
	_sg_box(Vector3(cx,SG_TOP+0.02,cz),Vector3(W-0.2,0.04,D-0.2),_bio_mat(Color("b88a5a"),0.0,0.6))
	var rail := _bio_mat(Color("ffffff"),0.0,0.3)
	var gap0 := SG_RAMP_X-1.6
	var gap1 := SG_RAMP_X+1.6
	for seg in [[SG_X0,gap0,SG_Z0],[gap1,SG_X1,SG_Z0],[SG_X0,SG_X1,SG_Z1]]:
		var a: float = seg[0]
		var b: float = seg[1]
		_sg_box(Vector3((a+b)/2.0,SG_TOP+0.55,float(seg[2])),Vector3(b-a,1.1,0.25),rail,true)
	for x in [SG_X0,SG_X1]:
		_sg_box(Vector3(x,SG_TOP+0.55,cz),Vector3(0.25,1.1,D),rail,true)
	# The ramp up from the grass (its foot meets the ground collider exactly, so no step).
	var a := Vector3(SG_RAMP_X,-0.04,SG_Z0+11.0)
	var b := Vector3(SG_RAMP_X,SG_TOP+0.02,SG_Z0)
	# A flat landing laid over the terrace edge, so the ramp joins it with no step.
	_sg_box(Vector3(SG_RAMP_X,SG_TOP+0.01,SG_Z0-0.9),Vector3(3.0,0.02,2.0),_bio_mat(Color("b88a5a"),0.0,0.6),true)
	var d := b-a
	var L := d.length()
	var X := d/L
	var Z := X.cross(Vector3.UP).normalized()
	var Y := Z.cross(X)
	var ctr := (a+b)/2.0-Y*0.15
	var xf := Transform3D(Basis(X,Y,Z),ctr)
	var rm := MeshInstance3D.new()
	rm.mesh = _bbox()
	rm.transform = Transform3D(Basis(X*L,Y*0.3,Z*3.0),ctr)
	rm.material_override = _bio_mat(Color("b88a5a"),0.0,0.6)
	sg_root.add_child(rm)
	var body := StaticBody3D.new()
	body.collision_mask = 0
	var sh := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(L,0.3,3.0)
	sh.shape = box
	sh.transform = xf
	body.add_child(sh)
	sg_root.add_child(body)
	for sx: float in [-1.6,1.6]:
		for k in 5:
			var p := a.lerp(b,float(k)/4.0)+Vector3(sx,0,0)
			_fc_part(sg_root,_bcone(0.05,0.05,1.0),p+Vector3(0,0.5,0),_fc_chrome())
			_fc_part(sg_root,_bsph(0.09),p+Vector3(0,1.05,0),_fc_glow(Color("ffe08a")))
	# Pergola with string lights, and the sign.
	for px in [SG_X0+0.5,SG_X1-0.5]:
		for pz in [SG_Z0-0.5,SG_Z1+0.5]:
			_sg_box(Vector3(px,SG_TOP+2.2,pz),Vector3(0.3,4.4,0.3),rail)
	for pz in [SG_Z0-0.5,SG_Z1+0.5]:
		_sg_box(Vector3(cx,SG_TOP+4.4,pz),Vector3(W-1.0,0.25,0.25),rail)
	for k in 9:
		var x := lerpf(SG_X0+1.0,SG_X1-1.0,float(k)/8.0)
		_sg_box(Vector3(x,SG_TOP+4.45,cz),Vector3(0.15,0.15,D-1.0),rail)
		for j in 6:
			var z := lerpf(SG_Z0-1.2,SG_Z1+1.2,float(j)/5.0)
			_fc_part(sg_root,_bsph(0.08),Vector3(x,SG_TOP+4.25-0.15*sin(float(j)*1.1),z),_fc_glow([Color("ffe08a"),Color("ff9ad0"),Color("9fd8ff")][(k+j) % 3]))
	var t := _sg_text("SKY GARDEN",Vector3(cx,SG_TOP+5.6,SG_Z0),Color("7dff9a"),90,90.0)
	t.pixel_size = 0.009
	_sg_text("Grow exotic plants · they grow while you're away",Vector3(cx,SG_TOP+4.95,SG_Z0),Color("ffffff"),36,40.0).pixel_size = 0.006
	_sg_text("SKY GARDEN ▲",Vector3(SG_RAMP_X,2.4,SG_Z0+11.5),Color("7dff9a"),40,30.0)
	# Eight beds in two rows of four.
	var soil := _bio_mat(Color("4a3020"),0.0,0.95)
	var wood := _bio_mat(Color("8a5a36"),0.0,0.6)
	for row in 2:
		for col in 4:
			var bc := Vector3(-410.5+float(col)*5.0,SG_TOP,[-633.5,-639.5][row])
			sg_beds.append(bc)
			_sg_box(bc+Vector3(0,0.25,0),Vector3(3.2,0.5,2.2),wood,true)
			_sg_box(bc+Vector3(0,0.52,0),Vector3(2.9,0.06,1.9),soil)
			var n := Node3D.new()
			n.position = bc+Vector3(0,0.55,0)
			sg_root.add_child(n)
			var lab := _sg_text("",bc+Vector3(0,2.6,0),Color("ffffff"),30,16.0)
			var spark := _fc_part(sg_root,_bsph(0.18),bc+Vector3(0,2.2,0),_fc_glow(Color("ffd23f")))
			spark.visible = false
			sg_nodes.append({"node":n,"plant":null,"spark":spark,"label":lab,"key":""})
	while sg_plots.size() < sg_beds.size():
		sg_plots.append([-1,0,0])
	# The Seed Stall (east end) and the Garden Codex board (west end).
	var st := Vector3(SG_X1-2.0,SG_TOP,-636.5)
	_sg_box(st+Vector3(0,0.55,0),Vector3(1.0,1.1,3.4),wood,true)
	for sz: float in [-1.6,1.6]:
		_sg_box(st+Vector3(0.3,1.6,sz),Vector3(0.12,3.2,0.12),rail)
	for k in 5:
		_sg_box(st+Vector3(0.3,3.2,-1.6+float(k)*0.8),Vector3(1.6,0.12,0.8),_bio_mat(Color("ff5d8f") if k % 2 == 0 else Color.WHITE,0.0,0.4))
	for k in 6:
		_fc_part(sg_root,_bsph(0.13),st+Vector3(-0.1,1.22,-1.3+float(k)*0.52),_bio_mat(SG_PLANTS[k*2][5],0.0,0.5))
	_sg_text("SEED STALL",st+Vector3(-0.4,2.6,0),Color("ffd23f"),56,25.0)
	var cb := Vector3(SG_X0+1.2,SG_TOP,-636.5)
	_sg_box(cb+Vector3(0,1.4,0),Vector3(0.2,2.2,3.2),_bio_mat(Color("1f3a2e"),0.1,0.6),true)
	_sg_text("GARDEN CODEX",cb+Vector3(0.4,2.85,0),Color("7dff9a"),48,25.0)
	_car_barrier([[Vector3(SG_RAMP_X,0.9,SG_Z0+12.2),Vector3(4.0,1.8,0.5),0.0]])
	_cull_person(sg_root,200.0)
	if OS.get_environment("HC_GARDEN_DEMO") != "" and "--city-shots" in OS.get_cmdline_user_args():
		# Developer screenshots only: a garden in full bloom (never saved).
		var demo := [[10,0],[7,2],[9,0],[11,3],[4,0],[8,1],[6,0],[3,0]]
		for p in demo.size():
			sg_plots[p] = [int(demo[p][0]),_sg_now()-(200000 if p != 6 else 2000),int(demo[p][1])]
	_sg_refresh_all()

func _sg_seed_spot() -> Vector3:
	return Vector3(SG_X1-3.2,SG_TOP,-636.5)

func _sg_codex_spot() -> Vector3:
	return Vector3(SG_X0+2.4,SG_TOP,-636.5)

# ---------------- plants ----------------
func _sg_plant_model(si: int, mut: int) -> Node3D:
	# An exotic plant built from simple shapes, about 1-2.5 m tall at full size.
	var n := Node3D.new()
	var P: Array = SG_PLANTS[si]
	var ca: Color = P[5]
	var cb: Color = P[6]
	var A: Material = _bio_mat(ca,0.1,0.45)
	var B: Material = _bio_mat(cb,0.1,0.45)
	var G: Material = _fc_glow(ca)
	if mut == 2:
		A = _bio_mat(Color("ffcf4a"),0.9,0.2)
		B = _bio_mat(Color("e8b84a"),0.9,0.25)
		G = _fc_glow(Color("ffd23f"))
	elif mut == 3:
		A = sg_rainbow
		B = sg_rainbow
		G = sg_rainbow
	var stem := _bio_mat(Color("3e8a3a"),0.0,0.7)
	match String(P[7]):
		"daisy":
			_fc_part(n,_bcone(0.03,0.04,0.7),Vector3(0,0.35,0),stem)
			for k in 10:
				var a := float(k)*TAU/10.0
				_fc_part(n,_bsph(0.12),Vector3(cos(a)*0.2,0.72,sin(a)*0.2),A,Vector3(1.4,0.3,0.7)).rotation.y = -a
			_fc_part(n,_bsph(0.11),Vector3(0,0.74,0),B)
		"lily":
			_fc_part(n,_bcone(0.03,0.04,0.9),Vector3(0,0.45,0),stem)
			for k in 6:
				var a := float(k)*TAU/6.0
				var pe := _fc_part(n,_bcone(0.0,0.1,0.5),Vector3(cos(a)*0.12,1.05,sin(a)*0.12),A)
				pe.rotation = Vector3(0,-a,0.7)
			_fc_part(n,_bsph(0.07),Vector3(0,0.95,0),G)
		"fern":
			for k in 8:
				var a := float(k)*TAU/8.0
				var fr := _fc_part(n,_bsph(0.3),Vector3(cos(a)*0.35,0.35,sin(a)*0.35),_bio_glass_mat(ca,0.55) if mut < 2 else A,Vector3(0.35,0.12,1.4))
				fr.rotation = Vector3(0.5,-a+PI/2.0,0)
			_fc_part(n,_bsph(0.08),Vector3(0,0.5,0),G)
		"cactus":
			_fc_part(n,_bcone(0.22,0.26,1.2),Vector3(0,0.6,0),B)
			for s in [-1.0,1.0]:
				_fc_part(n,_bcone(0.12,0.14,0.5),Vector3(s*0.32,0.85,0),B)
				_fc_part(n,_bcone(0.0,0.1,0.25),Vector3(s*0.32,1.2,0),G)
			_fc_part(n,_bcone(0.0,0.2,0.4),Vector3(0,1.4,0),G)
		"orchid":
			_fc_part(n,_bcone(0.03,0.04,1.2),Vector3(0,0.6,0),stem)
			for k in 4:
				_fc_part(n,_bsph(0.13),Vector3(0.12*sin(float(k)*1.7),0.9+float(k)*0.18,0.12*cos(float(k)*1.7)),G,Vector3(1.3,0.8,0.5))
			for k in 3:
				_fc_part(n,_bsph(0.2),Vector3(cos(float(k)*2.1)*0.25,0.12,sin(float(k)*2.1)*0.25),stem,Vector3(1.5,0.3,0.6))
		"snapper":
			_fc_part(n,_bcone(0.05,0.06,0.6),Vector3(0,0.3,0),stem)
			for s in [-1.0,1.0]:
				var j := _fc_part(n,_bsph(0.28),Vector3(0,0.75,s*0.06),A,Vector3(1,0.55,0.6))
				j.rotation.x = s*0.5
				_fc_part(n,_bsph(0.22),Vector3(0,0.75,s*0.04),B,Vector3(0.95,0.4,0.5)).rotation.x = s*0.5
			for k in 6:
				_fc_part(n,_bcone(0.0,0.025,0.12),Vector3(-0.24+float(k)*0.1,0.85,0),_bio_mat(Color.WHITE,0.0,0.4))
		"vine":
			_fc_part(n,_bcone(0.04,0.05,2.0),Vector3(0,1.0,0),_bio_mat(Color("8a5a36"),0.0,0.6))
			for k in 14:
				var a := float(k)*0.9
				_fc_part(n,_bsph(0.14),Vector3(cos(a)*0.22,0.2+float(k)*0.13,sin(a)*0.22),B)
				if k % 3 == 1:
					_fc_part(n,_bsph(0.14),Vector3(cos(a)*0.3,0.2+float(k)*0.13,sin(a)*0.3),A,Vector3(1,1.3,1))
		"lotus":
			_fc_part(n,_bcone(0.6,0.6,0.04),Vector3(0,0.05,0),_bio_mat(Color("3e9a4a"),0.0,0.6))
			for layer in 3:
				for k in 8:
					var a := float(k)*TAU/8.0+float(layer)*0.3
					var pe := _fc_part(n,_bsph(0.16-layer*0.03),Vector3(cos(a)*(0.28-layer*0.08),0.18+layer*0.08,sin(a)*(0.28-layer*0.08)),A if layer < 2 else B,Vector3(0.6,1.2,0.35))
					pe.rotation = Vector3(0,-a,0.5)
			_fc_part(n,_bsph(0.09),Vector3(0,0.42,0),G)
		"bamboo":
			for k in 5:
				var x := -0.5+float(k)*0.25
				var h := 1.4+0.3*float(k % 3)
				_fc_part(n,_bcone(0.06,0.07,h),Vector3(x,h/2.0,0.1*sin(float(k)*2.0)),A)
				for j in int(h/0.4):
					_fc_part(n,_bcone(0.075,0.075,0.04),Vector3(x,0.4*float(j+1),0.1*sin(float(k)*2.0)),B)
				_fc_part(n,_bsph(0.15),Vector3(x+0.1,h,0.1*sin(float(k)*2.0)),stem,Vector3(1.6,0.3,0.6))
		"rose":
			_fc_part(n,_bcone(0.03,0.04,1.1),Vector3(0,0.55,0),stem)
			for layer in 3:
				for k in 5:
					var a := float(k)*TAU/5.0+float(layer)*0.6
					_fc_part(n,_bsph(0.11),Vector3(cos(a)*(0.13-layer*0.04),1.15+layer*0.05,sin(a)*(0.13-layer*0.04)),A,Vector3(1,1.2,0.6)).rotation.y = -a
			_fc_part(n,_bsph(0.06),Vector3(0,1.3,0),G)
			for k in 4:
				_fc_part(n,_bsph(0.035),Vector3(cos(float(k)*1.6)*0.4,1.4+0.1*float(k),sin(float(k)*1.6)*0.4),G)
		"tree":
			_fc_part(n,_bcone(0.08,0.14,1.4),Vector3(0,0.7,0),_bio_mat(Color("d8dde3"),0.2,0.4))
			for k in 7:
				var a := float(k)*TAU/7.0
				_fc_part(n,_bsph(0.32),Vector3(cos(a)*0.35,1.55+0.15*sin(float(k)*2.0),sin(a)*0.35),_fc_glow(ca) if mut < 2 else A)
			_fc_part(n,_bsph(0.38),Vector3(0,1.85,0),_fc_glow(cb) if mut < 2 else B)
		"palm":
			_fc_part(n,_bcone(0.09,0.14,1.8),Vector3(0,0.9,0),_bio_mat(Color("8a5a36"),0.0,0.6))
			for k in 7:
				var a := float(k)*TAU/7.0
				var fr := _fc_part(n,_bcone(0.0,0.14,1.1),Vector3(cos(a)*0.45,1.75,sin(a)*0.45),G)
				fr.rotation = Vector3(0,-a,PI/2.0+0.4)
			_fc_part(n,_bsph(0.22),Vector3(0,1.85,0),A)
	return n

func _sg_refresh_all() -> void:
	for p in sg_nodes.size():
		_sg_refresh(p)

func _sg_refresh(p: int) -> void:
	# Rebuild a bed's plant when it changes, and size it by how far it has grown.
	var N: Dictionary = sg_nodes[p]
	var P: Array = sg_plots[p]
	var si := int(P[0])
	var key := "%d|%d|%d" % [si,int(P[1]),int(P[2])]
	if String(N["key"]) != key:
		N["key"] = key
		if N["plant"] != null and is_instance_valid(N["plant"]):
			(N["plant"] as Node).queue_free()
		N["plant"] = null
		if si >= 0:
			var m := _sg_plant_model(si,int(P[2]))
			(N["node"] as Node3D).add_child(m)
			N["plant"] = m
	var lab: Label3D = N["label"]
	var spark: MeshInstance3D = N["spark"]
	if si < 0:
		lab.text = "Empty bed · tap PLANT"
		lab.modulate = Color("cbd8de")
		spark.visible = false
		return
	var pr := _sg_progress(p)
	var giant := 1.45 if int(P[2]) == 1 else 1.0
	(N["plant"] as Node3D).scale = Vector3.ONE*lerpf(0.15,1.0,pr)*giant
	var mut := String(SG_MUTS[int(P[2])][0])
	var nm := ("%s %s" % [mut,SG_PLANTS[si][0]]).strip_edges() if pr >= 1.0 else String(SG_PLANTS[si][0])
	if pr >= 1.0:
		lab.text = "%s\nREADY!" % nm
		lab.modulate = Color("ffd23f")
	else:
		var left := int(SG_PLANTS[si][3])-(_sg_now()-int(P[1]))
		lab.text = "%s\n%d%%  ·  %s" % [nm,int(pr*100.0),_sg_time(maxi(left,0))]
		lab.modulate = SG_RARITY[int(SG_PLANTS[si][1])][1]
	spark.visible = pr >= 1.0

func _sky_garden_tick(delta: float) -> void:
	if sg_root == null or player == null or not place_open[2]:
		return
	if sg_rainbow != null:
		var c := Color.from_hsv(fposmod(clock*0.15,1.0),0.75,1.0)
		sg_rainbow.albedo_color = c
		sg_rainbow.emission = c
	if player.position.distance_to(SG_C) > 90.0:
		return
	for N in sg_nodes:
		var sp: MeshInstance3D = N["spark"]
		if sp.visible:
			sp.position.y = SG_TOP+2.1+sin(clock*3.0)*0.12
	sg_tick_t -= delta
	if sg_tick_t > 0.0:
		return
	sg_tick_t = 0.5
	_sg_refresh_all()

func _sg_ready_count() -> int:
	var n := 0
	for p in sg_plots.size():
		if int(sg_plots[p][0]) >= 0 and _sg_progress(p) >= 1.0:
			n += 1
	return n

func _sg_boot_note() -> void:
	# Coming back: tell the player what grew while they were away.
	if sg_told:
		return
	sg_told = true
	var n := _sg_ready_count()
	if n > 0:
		_feed_add("Sky Garden: %d plant%s ready to harvest!" % [n,"" if n == 1 else "s"],"")

# ---------------- interacting ----------------
func _sg_near() -> int:
	# The bed (0-7), the Seed Stall (100) or the Codex (101) you are standing at; -1 for none.
	if driving or player == null or paused or sg_root == null or not place_open[2]:
		return -1
	if player.position.y < SG_TOP+0.4:
		return -1
	var pp := Vector2(player.position.x,player.position.z)
	var ss := _sg_seed_spot()
	if pp.distance_to(Vector2(ss.x,ss.z)) < 1.8:
		return 100
	var cs := _sg_codex_spot()
	if pp.distance_to(Vector2(cs.x,cs.z)) < 1.8:
		return 101
	var best := -1
	var bd := 2.4
	for p in sg_beds.size():
		var b: Vector3 = sg_beds[p]
		var dd := pp.distance_to(Vector2(b.x,b.z))
		if dd < bd:
			bd = dd
			best = p
	return best

func _sg_button_text() -> String:
	var s := _sg_near()
	if s == 100:
		return "SEED STALL"
	if s == 101:
		return "GARDEN CODEX"
	var P: Array = sg_plots[s]
	if int(P[0]) < 0:
		return "PLANT A SEED"
	if _sg_progress(s) >= 1.0:
		return "HARVEST  +%s" % _money(_sg_value(s))
	return "GROWING %d%%" % int(_sg_progress(s)*100.0)

func _sg_value(p: int) -> int:
	var P: Array = sg_plots[p]
	return int(SG_PLANTS[int(P[0])][4])*int(SG_MUTS[int(P[2])][1])

func _sg_interact() -> void:
	var s := _sg_near()
	if s == 100:
		_sg_open("shop",-1)
	elif s == 101:
		_sg_open("codex",-1)
	elif s >= 0:
		var P: Array = sg_plots[s]
		if int(P[0]) < 0:
			_sg_open("plant",s)
		elif _sg_progress(s) >= 1.0:
			_sg_harvest(s)
		else:
			var left := int(SG_PLANTS[int(P[0])][3])-(_sg_now()-int(P[1]))
			_show_toast("%s is growing: ready in %s. It keeps growing while you're away!" % [SG_PLANTS[int(P[0])][0],_sg_time(maxi(left,0))])

func _sg_buy(si: int) -> bool:
	var stock := _sg_stock()
	var have := 0
	for e in stock:
		if int(e[0]) == si:
			have = int(e[1])-int(sg_bought.get(si,0))
	if have <= 0:
		_show_toast("%s seeds are sold out. New stock in %s." % [SG_PLANTS[si][0],_sg_time(SG_RESTOCK-_sg_now() % SG_RESTOCK)])
		return false
	var price := int(SG_PLANTS[si][2])
	if cash < price:
		_show_toast("%s seeds cost %s (you have %s)." % [SG_PLANTS[si][0],_money(price),_money(cash)])
		return false
	cash -= price
	sg_bought[si] = int(sg_bought.get(si,0))+1
	sg_bag[si] = int(sg_bag.get(si,0))+1
	_show_toast("Bought a %s seed!" % SG_PLANTS[si][0])
	if not ("--smoke-test" in OS.get_cmdline_user_args()):
		_play_coin()
	_save_progress()
	return true

func _sg_plant(p: int, si: int) -> bool:
	if int(sg_bag.get(si,0)) <= 0 or int(sg_plots[p][0]) >= 0:
		return false
	sg_bag[si] = int(sg_bag[si])-1
	var t := _sg_now()
	sg_plots[p] = [si,t,_sg_mut_roll(t,p,_harbor_night() and sg_test_now == 0)]
	_sg_refresh(p)
	_show_toast("Planted %s: ready in %s, even if you close the game." % [SG_PLANTS[si][0],_sg_time(int(SG_PLANTS[si][3]))])
	_save_progress()
	return true

func _sg_harvest(p: int) -> void:
	var P: Array = sg_plots[p]
	var si := int(P[0])
	if si < 0 or _sg_progress(p) < 1.0:
		return
	var mut := int(P[2])
	var value := _sg_value(p)
	var xp := 10+int(SG_PLANTS[si][1])*15
	cash += value
	bonus_xp += xp
	var name := ("%s %s" % [SG_MUTS[mut][0],SG_PLANTS[si][0]]).strip_edges()
	var new := (sg_codex & (1 << si)) == 0
	sg_codex |= 1 << si
	if mut > 0:
		sg_mutseen |= 1 << mut
	sg_plots[p] = [-1,0,0]
	_sg_refresh(p)
	_show_toast("Harvested %s!  +%s  +%d XP%s" % [name,_money(value),xp,"  ·  NEW in your Codex!" if new else ""])
	if mut == 3:
		_feed_add("RAINBOW %s harvested! +%s" % [SG_PLANTS[si][0],_money(value)],"")
	if _bits(sg_codex) == SG_PLANTS.size() and not sg_all_done:
		sg_all_done = true
		cash += SG_ALL_PAY
		_show_toast("MASTER GARDENER!  Every plant grown: +%s" % _money(SG_ALL_PAY))
		_feed_add("Master Gardener: all %d plants grown!" % SG_PLANTS.size(),"")
	_stat_add("sg_harvests")
	if not ("--smoke-test" in OS.get_cmdline_user_args()):
		_play_coin()
	_save_progress()

