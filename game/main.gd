	# ---- Aurora Residences: champagne glass with white balconies all the way up ----
	var ac := T+Vector3(-10.5,7.4,-10.5)
	var ah := 88.0
	var aglass := _gc_glass("aurora",Color("d8c3a0"))
	_gb("box",aglass,ac+Vector3(0,ah/2.0,0),Vector3(17,ah,15))
	var y := 3.4
	while y < ah-6.0:
