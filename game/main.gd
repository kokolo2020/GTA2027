		for b in [false,true]:
			board_on = b
			var p0 := player.position
			stick = Vector2(0.0,-1.0)
			for i in 90:
				await get_tree().physics_frame
			print("HOME_CHECK board=%s moved=%.2f from %s to %s floor=%s home_in=%d paused=%s" % [str(b),player.position.distance_to(p0),str(p0.round()),str(player.position.round()),str(player.is_on_floor()),home_in,str(paused)])
			stick = Vector2(1.0,0.0)
			var p1 := player.position
			for i in 60:
				await get_tree().physics_frame
			print("HOME_CHECK2 moved=%.2f at %s" % [player.position.distance_to(p1),str(player.position.round())])
		get_tree().quit()
	elif "--nav-check" in OS.get_cmdline_user_args():
		# Developer check: build every walk grid and run the v0.44 checks on their own.
		var t0 := Time.get_ticks_msec()
		await _smoke_strollers()
		print("NAV_CHECK_OK %d ms stalls %s" % [Time.get_ticks_msec()-t0,str(street_stalls)])
		get_tree().quit()
	elif "--city-shots" in OS.get_cmdline_user_args():
		await _city_shots()
	elif "--daily-shots" in OS.get_cmdline_user_args():
		await _daily_shots()
	elif "--crate-shots" in OS.get_cmdline_user_args():
		await _crate_shots()
	elif "--bake-map" in OS.get_cmdline_user_args():
		await _bake_map()

const HAZE := Color("c6e1ea")
# v0.24: big flat surfaces (roads, grass, pavements) get a subtle world-space texture.
const SURF_ASPHALT := ["354653","4a5560","394552","33383e"]
const SURF_GRASS := ["91ab82","6f945c","78a06b","6aa35a","7fae68","74b062","5f984f","9cc085"]
const SURF_PAVE := ["8f8d86","9c9a92","b9b6ad","a9a69e","8f8c85","e8d5ad","a19c90","9d9a92","8f9396"]
var surf_mats := {}
var surf_tex := {}

func _surf_texture(kind: String) -> NoiseTexture2D:
	if surf_tex.has(kind):
		return surf_tex[kind]
	var noise := FastNoiseLite.new()
	noise.seed = {"asphalt":11,"grass":23,"pave":37}[kind]
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH if kind == "grass" else FastNoiseLite.TYPE_VALUE
	noise.frequency = {"asphalt":0.35,"grass":0.025,"pave":0.12}[kind]
	noise.fractal_octaves = 3
	var tex := NoiseTexture2D.new()
	tex.width = 256
	tex.height = 256
	tex.seamless = true
	tex.generate_mipmaps = true
	tex.noise = noise
	var ramp := Gradient.new()
	var lo := {"asphalt":0.8,"grass":0.78,"pave":0.86}[kind] as float
	ramp.set_color(0,Color(lo,lo,lo))
	ramp.set_color(1,Color(1,1,1))
	tex.color_ramp = ramp
	surf_tex[kind] = tex
	return tex

func _surface_material(color: Color, kind: String) -> StandardMaterial3D:
	var key := color.to_html(false)
	if surf_mats.has(key):
		return surf_mats[key]
	var mat := StandardMaterial3D.new()
	if kind == "asphalt":
		# v0.34.4: futuristic roads: smooth dark glossy panels with thin glowing seams (no cracks).
		_future_road(mat,color)
		surf_mats[key] = mat
		return mat
	if kind == "pave":
		_future_pave(mat,color)
		surf_mats[key] = mat
		return mat
	# v0.30: photo textures (CC0, Poly Haven) instead of flat noise. The tint keeps each surface's hue.
	var photo := {"asphalt":"asphalt","grass":"grass","pave":"pavement"}[kind] as String
	var sc := {"asphalt":0.3,"grass":0.22,"pave":0.45}[kind] as float
	if _real_tex(photo+"_diff") != null:
		var tint := Color.WHITE.lerp(color,{"asphalt":0.25,"grass":0.35,"pave":0.45}[kind] as float)
		if kind == "pave" and color.r-color.b < 0.12:
			# Grey pavements: cool the warm photo down to plain concrete.
			tint = Color(0.86,0.9,0.97)*(0.75+0.35*color.v)
		_real_setup(mat,photo,tint*({"asphalt":0.92,"grass":1.05,"pave":1.12}[kind] as float),sc)
	else:
		var lift := {"asphalt":1.1,"grass":1.12,"pave":1.07}[kind] as float
		mat.albedo_color = Color(color.r*lift,color.g*lift,color.b*lift)
		mat.albedo_texture = _surf_texture(kind)
		mat.uv1_triplanar = true
		mat.uv1_world_triplanar = true
		sc = {"asphalt":0.22,"grass":0.05,"pave":0.4}[kind] as float
		mat.uv1_scale = Vector3(sc,sc,sc)
		mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	mat.roughness = 0.95
	surf_mats[key] = mat
	return mat

# ---------- v0.34.6: futuristic towers for the old city ----------
var tower_glass: StandardMaterial3D
var tower_pearl: StandardMaterial3D

func _future_tower(base: Vector3, idx: int) -> void:
	if tower_glass == null:
		tower_glass = StandardMaterial3D.new()
		tower_glass.resource_name = "GlassBlue"
		tower_glass.albedo_color = Color("6aa9d8")
		_real_glass(tower_glass,true)
		tower_pearl = StandardMaterial3D.new()
		tower_pearl.albedo_color = Color("eef2f5")
		tower_pearl.metallic = 0.3
		tower_pearl.roughness = 0.22
	var root := Node3D.new()
	root.position = base
	add_child(root)
	var neon: Color = [NEON_CYAN,NEON_VIOLET,Color("ff5fd2"),Color("6fe39b")][idx % 4]
	var nm := _neon_mat(neon)
	# Pearl podium.
	_fc_part(root,BoxMesh.new(),Vector3(0,0.9,0),tower_pearl,Vector3(12.5,1.8,11.5))
	_fc_part(root,BoxMesh.new(),Vector3(0,1.85,0),nm,Vector3(12.6,0.08,11.6))
	match idx % 4:
		0:
			# Round glass tower with neon rings and a halo on top.
			var h := 30.0+float(idx % 3)*6.0
			var c := _fc_part(root,_fc_cone(4.6,4.9,h),Vector3(0,1.8+h/2.0,0),tower_glass)
			c.mesh.set("radial_segments",24)
			var y := 6.0
			while y < h:
				_fc_part(root,_fc_torus(4.75,5.0),Vector3(0,1.8+y,0),nm)
				y += 6.0
			_fc_part(root,_fc_cone(4.0,4.9,0.6),Vector3(0,1.8+h+0.3,0),tower_pearl)
			_fc_part(root,_fc_torus(2.6,2.85),Vector3(0,1.8+h+2.2,0),nm)
		1:
			# Three stepped glass tiers with pearl edges.
			var y0 := 1.8
			var w := Vector2(10.0,9.0)
			for t in 3:
				var th := [12.0,10.0,9.0][t] as float
				_fc_part(root,BoxMesh.new(),Vector3(0,y0+th/2.0,0),tower_glass,Vector3(w.x,th,w.y))
				_fc_part(root,BoxMesh.new(),Vector3(0,y0+th+0.15,0),tower_pearl,Vector3(w.x+0.5,0.3,w.y+0.5))
				_fc_part(root,BoxMesh.new(),Vector3(0,y0+th+0.34,0),nm,Vector3(w.x+0.55,0.06,w.y+0.55))
				y0 += th+0.3
				w *= 0.74
			_fc_part(root,_fc_cone(0.05,0.3,6.0),Vector3(0,y0+3.0,0),tower_pearl)
		2:
			# Twisting tower: glass slabs turning a little at every floor.
			var floors := 11+idx % 3
			for f in floors:
				var slab := _fc_part(root,BoxMesh.new(),Vector3(0,1.8+1.4+float(f)*2.8,0),tower_glass,Vector3(8.6,2.6,8.6))
				slab.rotation.y = float(f)*0.085
				var band := _fc_part(root,BoxMesh.new(),Vector3(0,1.8+2.75+float(f)*2.8,0),tower_pearl if f % 3 else nm,Vector3(8.9,0.18,8.9))
				band.rotation.y = float(f)*0.085
		_:
			# Slim tower with a floating sky garden and a spire.
			var h := 34.0
			_fc_part(root,BoxMesh.new(),Vector3(0,1.8+h/2.0,0),tower_glass,Vector3(7.0,h,7.0))
			for sx in [-1.0,1.0]:
				for sz in [-1.0,1.0]:
					_fc_part(root,BoxMesh.new(),Vector3(sx*3.55,1.8+h/2.0,sz*3.55),tower_pearl,Vector3(0.35,h,0.35))
			_fc_part(root,_fc_cone(6.0,5.0,1.0),Vector3(0,1.8+h*0.62,0),tower_pearl)
			_fc_part(root,_fc_torus(5.7,6.1),Vector3(0,1.8+h*0.62+0.5,0),nm)
			for k in 6:
				var a := TAU*float(k)/6.0
				var tree := _fc_part(root,_fc_sphere(0.8),Vector3(sin(a)*4.6,1.8+h*0.62+1.3,cos(a)*4.6),_fc_glow(Color("3fbf6a")))
				tree.scale = Vector3(1,0.8,1)
			_fc_part(root,_fc_cone(0.04,0.35,8.0),Vector3(0,1.8+h+4.0,0),tower_pearl)
			_fc_part(root,_fc_sphere(0.3),Vector3(0,1.8+h+8.1,0),nm)
	for c in root.get_children():
		if c is GeometryInstance3D:
			(c as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON

# ---------- v0.34.4: "100 years from now" skins for walls, roofs and pavements ----------
var skin_mats: Array = []
var wall_tex: ImageTexture
var wall_glow: ImageTexture
var roof_tex: ImageTexture
var pave_tex: ImageTexture

func _skin_textures() -> void:
	if wall_tex != null:
		return
	var n := 128
	var wi := Image.create(n,n,true,Image.FORMAT_RGB8)
	var wg := Image.create(n,n,true,Image.FORMAT_RGB8)
	var ri := Image.create(n,n,true,Image.FORMAT_RGB8)
	var pi := Image.create(n,n,true,Image.FORMAT_RGB8)
	for y in n:
		for x in n:
			# Walls: smooth pearl panels (one tile = 6 m: two 3 m floors), a slim seam between panels
			# and a glowing band at every floor line.
			var v := 0.93-0.05*float(y % 64)/64.0
			var c := Color(v,v,v*1.01)
			var g := Color.BLACK
			if y % 64 < 3:
				c = Color(0.55,0.62,0.7)
				g = Color(0.25,0.9,1.0) if y % 64 == 1 else Color(0.05,0.3,0.4)
			elif x % 32 == 0:
				c = Color(0.78,0.8,0.84)
			wi.set_pixel(x,y,c)
			wg.set_pixel(x,y,g)
			# Roofs: deep blue solar glass in a fine grid.
			var rv := Color(0.12,0.17,0.3) if (x % 16 != 0 and y % 16 != 0) else Color(0.55,0.65,0.8)
			ri.set_pixel(x,y,rv)
			# Pavements: smooth light stone slabs with thin seams (one tile = 3 m).
			var pv := 0.86+0.02*sin(float(x)*0.2)*sin(float(y)*0.17)
			pi.set_pixel(x,y,Color(0.68,0.72,0.77) if (x % 64 == 0 or y % 64 == 0) else Color(pv,pv,pv*1.02))
	for im in [wi,wg,ri,pi]:
		(im as Image).generate_mipmaps()
	wall_tex = ImageTexture.create_from_image(wi)
	wall_glow = ImageTexture.create_from_image(wg)
	roof_tex = ImageTexture.create_from_image(ri)
	pave_tex = ImageTexture.create_from_image(pi)

func _skin_common(mat: BaseMaterial3D, tex: Texture2D, scale: float) -> void:
	mat.albedo_texture = tex
	mat.normal_enabled = false
	mat.uv1_triplanar = true
	mat.uv1_world_triplanar = true
	mat.uv1_scale = Vector3(scale,scale,scale)
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC

func _future_wall(mat: BaseMaterial3D, color: Color) -> void:
	_skin_textures()
	_skin_common(mat,wall_tex,1.0/6.0)
	# A soft hint of each building's old colour, as a pastel on pearl.
	mat.albedo_color = Color.WHITE.lerp(Color(color.r,color.g,color.b).lightened(0.25),0.35)
	mat.emission_enabled = true
	mat.emission = Color.BLACK
	mat.emission_texture = wall_glow
	mat.emission_energy_multiplier = 0.25
	mat.metallic = 0.2
	mat.roughness = 0.3
	mat.metallic_specular = 0.6
	skin_mats.append(mat)

func _future_roof(mat: BaseMaterial3D) -> void:
	_skin_textures()
	_skin_common(mat,roof_tex,1.0/3.0)
	mat.albedo_color = Color.WHITE
	mat.metallic = 0.6
	mat.roughness = 0.15
	mat.metallic_specular = 0.9

func _future_pave(mat: BaseMaterial3D, color: Color) -> void:
	_skin_textures()
	_skin_common(mat,pave_tex,1.0/3.0)
	mat.albedo_color = Color.WHITE.lerp(color.lightened(0.2),0.3)
	mat.roughness = 0.45
	mat.metallic_specular = 0.5

# ---------- v0.34.4: futuristic road surface ----------
const ROAD_TILE := 256
const ROAD_PANEL := 128   # pixels per panel; one texture tile covers 4 m, so panels are 2 m
var road_mats: Array = []
var road_tex: ImageTexture
var road_glow: ImageTexture

func _road_textures() -> void:
	if road_tex != null:
		return
	var img := Image.create(ROAD_TILE,ROAD_TILE,true,Image.FORMAT_RGB8)
	var glow := Image.create(ROAD_TILE,ROAD_TILE,true,Image.FORMAT_RGB8)
	var rng := RandomNumberGenerator.new()
	rng.seed = 2034
	for y in ROAD_TILE:
		for x in ROAD_TILE:
			var px := x % ROAD_PANEL
			var py := y % ROAD_PANEL
			# Smooth composite with a very fine grain, a soft sheen across each panel.
			var v := 0.62+rng.randf_range(-0.035,0.035)+0.04*sin(float(px)/float(ROAD_PANEL)*PI)
			var c := Color(v*0.92,v*0.95,v)
			var g := Color.BLACK
			var seam := px < 2 or py < 2
			if seam:
				c = Color(0.3,0.36,0.42)
				g = Color(0.15,0.85,1.0)
			elif (px == 4 or py == 4 or px == ROAD_PANEL-3 or py == ROAD_PANEL-3):
				c = c.darkened(0.12)
			# Tiny light dots at the panel corners.
			if (px >= 60 and px <= 67 and py >= 60 and py <= 67) and (x/ROAD_PANEL+y/ROAD_PANEL) % 2 == 0:
				var d := Vector2(px-63.5,py-63.5).length()
				if d < 3.5:
					c = Color(0.5,0.6,0.7)
					g = Color(0.5,0.3,1.0)
			img.set_pixel(x,y,c)
			glow.set_pixel(x,y,g)
	img.generate_mipmaps()
	glow.generate_mipmaps()
	road_tex = ImageTexture.create_from_image(img)
	road_glow = ImageTexture.create_from_image(glow)

func _future_road(mat: StandardMaterial3D, color: Color) -> void:
	_road_textures()
	# Each old asphalt colour keeps a slightly different shade, all deep graphite-blue.
	var shade := 0.2+0.12*color.v
	mat.albedo_color = Color(shade*0.92,shade,shade*1.15)
	mat.albedo_texture = road_tex
	mat.emission_enabled = true
	# Emission adds the colour and the texture, so the colour stays black: only the seams glow.
	mat.emission = Color.BLACK
	mat.emission_texture = road_glow
	mat.emission_energy_multiplier = 0.35
	mat.roughness = 0.62
	mat.metallic = 0.0
	mat.metallic_specular = 0.3
	mat.uv1_triplanar = true
	mat.uv1_world_triplanar = true
	mat.uv1_scale = Vector3(0.25,0.25,0.25)
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	road_mats.append(mat)

# ---------- v0.30: real-looking materials (CC0 photo textures from Poly Haven, see credits.txt) ----------
const REAL_WALLS := {
	"brick":["SchoolBrick","Wall0","Terracotta"],
	"plaster":["Wall1","Wall2","Wall3","HWall0","HWall1","HotelWall","HospitalWall","ShopWall0","ShopWall1","Wall","BankMarble","LibraryTeal","FireRed"],
	"facade":["Stone","StoneGrey","TwrBase"],
	"concrete":["Concrete"],
	"metal":["WhWall","HangarShell","Cont0","Cont1","Cont2"],
	"roof":["HRoof0","HRoof1","Roof"],
	"bark":["Bark","PalmTrunk"],
}
# Metres of wall one copy of each photo covers.
const REAL_SIZE := {"brick":2.4,"plaster":3.0,"facade":4.0,"concrete":3.0,"metal":2.5,"roof":2.5,"bark":1.2,"asphalt":3.3,"grass":4.5,"pavement":2.2}
# How much of the model's own colour tints the photo (brick and roof photos already have their colour).
const REAL_TINT := {"brick":0.25,"plaster":0.85,"facade":0.6,"concrete":0.5,"metal":0.8,"roof":0.3,"bark":0.3}
const GLASS_NAMES := ["GlassBlue","GlassDark","GlassTeal","GlassLobby","WinGlass"]
const FOLIAGE_NAMES := ["Leaf","Leaf2","Pine","PalmLeaf","Bush"]
var foliage_tex: NoiseTexture2D
var foliage_nor: NoiseTexture2D

func _real_foliage(bm: BaseMaterial3D) -> void:
	# Leafy clumps: cellular noise gives clusters of leaves with dark gaps; a matching bump map.
	if foliage_tex == null:
		var noise := FastNoiseLite.new()
		noise.noise_type = FastNoiseLite.TYPE_CELLULAR
		noise.frequency = 0.09
		noise.cellular_return_type = FastNoiseLite.RETURN_DISTANCE2_SUB
		noise.fractal_type = FastNoiseLite.FRACTAL_FBM
		noise.fractal_octaves = 2
		noise.seed = 404
		foliage_tex = NoiseTexture2D.new()
		foliage_tex.width = 256
		foliage_tex.height = 256
		foliage_tex.seamless = true
		foliage_tex.generate_mipmaps = true
		foliage_tex.noise = noise
		var ramp := Gradient.new()
		ramp.set_color(0,Color(0.32,0.4,0.28))
		ramp.set_color(1,Color(1.15,1.2,1.0))
		ramp.add_point(0.55,Color(0.85,0.95,0.8))
		foliage_tex.color_ramp = ramp
		foliage_nor = NoiseTexture2D.new()
		foliage_nor.width = 256
		foliage_nor.height = 256
		foliage_nor.seamless = true
		foliage_nor.generate_mipmaps = true
		foliage_nor.as_normal_map = true
		foliage_nor.bump_strength = 6.0
		foliage_nor.noise = noise
	# Cheap on purpose (trees overlap a lot on screen): one texture lookup on the model's own UVs, no bump map.
	bm.albedo_texture = foliage_tex
	bm.uv1_scale = Vector3(3,3,3)
	bm.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	bm.roughness = 0.85
	real_mats.append(bm)
var real_tex := {}
var real_mats: Array = []
var real_done := {}
var window_tex: ImageTexture
var window_lit_tex: ImageTexture

func _real_tex(name: String) -> Texture2D:
	if real_tex.has(name):
		return real_tex[name]
	var path := "res://textures/%s.jpg" % name
	var t: Texture2D = load(path) if ResourceLoader.exists(path) else null
	real_tex[name] = t
	return t

func _real_setup(mat: BaseMaterial3D, kind: String, tint: Color, scale := -1.0) -> void:
	var diff := _real_tex(kind+"_diff")
	if diff == null:
		return
	mat.albedo_texture = diff
	mat.albedo_color = tint
	# The browser version skips the bump detail (normal maps) to keep the frame rate up; since
	# v0.51.3 they are not even packed into the web build, so it downloads faster.
	var lite := OS.has_feature("android") or OS.has_feature("web") or "--web-lite" in OS.get_cmdline_user_args()
	var nor := _real_tex(kind+"_nor") if not lite else null
	if nor != null and not lite:
		mat.normal_enabled = true
		mat.normal_texture = nor
		mat.normal_scale = 0.8
	mat.uv1_triplanar = true
	mat.uv1_world_triplanar = true
	var sc := scale if scale > 0.0 else 1.0/float(REAL_SIZE.get(kind,3.0))
	mat.uv1_scale = Vector3(sc,sc,sc)
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	real_mats.append(mat)

func _real_kind(base: String) -> String:
	for kind in REAL_WALLS:
		if base in (REAL_WALLS[kind] as Array):
			return kind
	return ""

func _realify(model: Node) -> void:
	# Give a loaded model's walls, roofs and glass real-looking materials. The materials are shared
	# by every copy of the model, so each one is changed only once.
	var stack: Array[Node] = [model]
	while stack.size() > 0:
		var n: Node = stack.pop_back()
		stack.append_array(n.get_children())
		if not (n is MeshInstance3D) or (n as MeshInstance3D).mesh == null:
			continue
		var mesh: Mesh = (n as MeshInstance3D).mesh
		for si in mesh.get_surface_count():
			var m := mesh.surface_get_material(si)
			if not (m is BaseMaterial3D) or real_done.has(m.get_rid()):
				continue
			real_done[m.get_rid()] = true
			var bm := m as BaseMaterial3D
			var base := m.resource_name.get_slice(".",0)
			var kind := _real_kind(base)
			if kind == "roof":
				_future_roof(bm)
			elif kind != "" and kind != "bark":
				# v0.34.4: 100 years on: no brick or plaster, sleek pearl panels with glowing floor bands.
				_future_wall(bm,bm.albedo_color)
			elif kind != "":
				var tint := Color.WHITE.lerp(bm.albedo_color,float(REAL_TINT.get(kind,0.5)))
				_real_setup(bm,kind,tint,1.0/float(REAL_SIZE[kind]))
				bm.roughness = 0.9
			elif base in GLASS_NAMES:
				_real_glass(bm,base != "WinGlass")
			elif base in FOLIAGE_NAMES:
				_real_foliage(bm)
			elif base == "BoardFace":
				# v0.31: billboards are glowing hologram screens.
				if holo_board_mat == null:
					holo_board_mat = _holo_material(0.5)
				(n as MeshInstance3D).set_surface_override_material(si,holo_board_mat)

func _real_glass(bm: BaseMaterial3D, grid: bool) -> void:
	# Glass reflects the sky. Big curtain walls get window frames, and at night only some windows are lit.
	bm.metallic = 0.55
	bm.roughness = 0.18
	bm.metallic_specular = 0.8
	if not grid:
		return
	if window_tex == null:
		_make_window_textures()
	bm.albedo_color = bm.albedo_color.lightened(0.15)
	bm.albedo_texture = window_tex
	bm.uv1_triplanar = true
	bm.uv1_world_triplanar = true
	# One tile = 8 windows across (1.6 m each) and 4 floors (3.4 m each).
	bm.uv1_scale = Vector3(1.0/12.8,1.0/13.6,1.0/12.8)
	bm.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	bm.emission_texture = window_lit_tex
	bm.emission_operator = BaseMaterial3D.EMISSION_OP_MULTIPLY
	real_mats.append(bm)

func _make_window_textures() -> void:
	# 8 x 4 windows per tile: dark frames, glass panes with a soft vertical sheen; a second image marks
	# which windows light up at night (about 4 in 10, in a few warm and cool shades).
	var w := 256
	var h := 256
	var img := Image.create(w,h,true,Image.FORMAT_RGB8)
	var lit := Image.create(w,h,true,Image.FORMAT_RGB8)
	var rng := RandomNumberGenerator.new()
	rng.seed = 3030
	var on := []
	var shades := [Color(1.0,0.86,0.62),Color(0.95,0.78,0.5),Color(0.8,0.85,0.95),Color(0.62,0.55,0.42)]
	for k in 32:
		on.append(shades[rng.randi() % shades.size()] if rng.randf() < 0.42 else Color(0,0,0))
	for y in h:
		for x in w:
			var cx := x % 32
			var cy := y % 64
			var frame := cx < 2 or cy < 3 or (cy > 54)
			var col := Color(0.35,0.37,0.4)
			if not frame:
				var sheen := 0.78+0.22*sin(float(cx)/30.0*PI)*(1.0-float(cy)/64.0)
				col = Color(sheen,sheen,sheen*1.02)
			if cy > 54 and cy < 64:
				col = Color(0.62,0.62,0.6)
			img.set_pixel(x,y,col)
			var idx := int(x/32)+8*int(y/64)
			lit.set_pixel(x,y,Color(0,0,0) if frame else (on[idx] as Color))
	img.generate_mipmaps()
	lit.generate_mipmaps()
	window_tex = ImageTexture.create_from_image(img)
	window_lit_tex = ImageTexture.create_from_image(lit)


func _material(color: Color) -> StandardMaterial3D:
	var hex := color.to_html(false)
	if hex in SURF_ASPHALT:
		return _surface_material(color,"asphalt")
	if hex in SURF_GRASS:
		return _surface_material(color,"grass")
	if hex in SURF_PAVE:
		return _surface_material(color,"pave")
	if hex in ["eef0ec","f2c230","e7d9a4","f4f1e8"]:
		# v0.31: road lines share one material per colour and glow faintly at night.
		if not line_mats.has(hex):
			var lm := StandardMaterial3D.new()
			lm.albedo_color = color
			lm.roughness = 0.85
			lm.emission_enabled = true
			lm.emission = color.lerp(Color("bff6ff"),0.4)
			lm.emission_energy_multiplier = 0.0
			line_mats[hex] = lm
			night_lines.append(lm)
		return line_mats[hex]
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.85
	return mat

func _box(parent: Node3D, pos: Vector3, size: Vector3, color: Color, solid := false) -> MeshInstance3D:
	_note_road(pos,size,0.0,color)
	if not solid and (parent == self or parent.has_meta("static_floor")):
		_floor_note(pos,size)
	var mesh := MeshInstance3D.new()
	var shape := BoxMesh.new()
	shape.size = size
	mesh.mesh = shape
	mesh.material_override = _material(color)
	mesh.position = pos
	parent.add_child(mesh)
	if solid:
		var body := StaticBody3D.new()
		var collider := CollisionShape3D.new()
		var box := BoxShape3D.new()
		box.size = size
		collider.shape = box
		body.position = pos
		body.add_child(collider)
		parent.add_child(body)
	return mesh

func _sign(text: String, pos: Vector3, tint := Color.WHITE, font_size := 48) -> Label3D:
	var label := Label3D.new()
	label.text = text
	label.font_size = font_size
	label.modulate = tint
	label.position = pos
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.outline_size = 8
	label.pixel_size = 0.014
	add_child(label)
	return label

