const NICK_MIN := 3
const NICK_MAX := 14
const NICK_BLOCK := ["fuck","fuk","shit","bitch","cunt","dick","cock","pussy","nigg","fag","whore","slut","rape","nazi","hitler","asshole","bastard","porn","penis","vagina","retard","wank","twat"]
