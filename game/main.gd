func _peer_look(peer: Dictionary, av: Variant) -> void:
	# v0.33.4: other players look the way they dress themselves (body, shirt, pants and hat),
	# so everyone sees the same person on every phone. Older versions send no look: keep the random one.
	if not (av is Array) or (av as Array).size() < 3 or (peer.get("person",{}) as Dictionary).is_empty():
		return
	var sh := clampi(int(av[0]),0,SHIRTS.size()-1)
	var pa := clampi(int(av[1]),0,PANTS.size()-1)
	var ht := clampi(int(av[2]),0,HATS.size()-1)
	var ge := 0
	if (av as Array).size() >= 5:
		var g := int(av[3])
		# 0.34.2+ sends a mask with bit 7 set; 0.34.0/0.34.1 sent one item index.
		ge = (g & 127 & ((1 << GEAR.size())-2)) if g & 128 else ((1 << clampi(g,0,GEAR.size()-1)) & ~1)
	var pt := clampi(int(av[4]),0,PETS.size()-1) if (av as Array).size() >= 5 else 0
	var key := "%d|%d|%d|%d|%d" % [sh,pa,ht,ge,pt]
	if String(peer.get("look","")) == key:
		return
	var foot: Node3D = peer["foot"]
	if not peer.has("look"):
		# First real look: rebuild the body as the same character everyone plays.
		var old: Dictionary = peer["person"]
		(old["root"] as Node).queue_free()
		var pp := _make_person(foot,0,{"Shirt":SHIRTS[sh]["color"],"Pants":PANTS[pa]["color"],"Skin":Color("ac7552"),"Hair":Color("2b1d14"),"Shoes":Color("eef1f2"),"Eye":Color("1c1c22")},true)
		if pp.is_empty():
			return
		peer["person"] = pp
		var hh := Node3D.new()
		hh.position.y = _hat_y(0.0)
		if pp.has("ap"):
			hh.position.z = K_HEAD_Z
			hh.scale = Vector3.ONE*K_HAT_SCALE
		foot.add_child(hh)
		peer["hat"] = hh
	else:
		var pm: Dictionary = (peer["person"] as Dictionary)["mats"]
		(pm["Shirt"] as StandardMaterial3D).albedo_color = SHIRTS[sh]["color"]
		(pm["Pants"] as StandardMaterial3D).albedo_color = PANTS[pa]["color"]
		if (peer["person"] as Dictionary).has("body_mat"):
			_ksync(peer["person"])
	peer["look"] = key
	_build_hat(peer["hat"],ht,false)
	if not peer.has("gear"):
		var gh := Node3D.new()
		gh.position.y = 0.99
		foot.add_child(gh)
		peer["gear"] = gh
	_build_gear(peer["gear"],ge)
	if peer.has("pet") and is_instance_valid(peer["pet"]):
		(peer["pet"] as Node).queue_free()
	peer.erase("pet")
	if pt > 0:
		var pn := Node3D.new()
		pn.position = Vector3(0.95,0,0.8)
		foot.add_child(pn)
		_build_pet(pn,pt)
		peer["pet"] = pn

func _online_tint(node: Node, color: Color) -> void:
	if node is MeshInstance3D:
		var mi := node as MeshInstance3D
		if mi.mesh != null:
			for surface in mi.mesh.get_surface_count():
				var m := mi.mesh.surface_get_material(surface)
				var mat_name := m.resource_name if m != null else ""
				if mat_name.begins_with("Body"):
					mi.set_surface_override_material(surface,_paint_mat(color))
				elif mat_name.begins_with("Cabin"):
					mi.set_surface_override_material(surface,_paint_mat(color.darkened(0.5)))
	for child in node.get_children():
		_online_tint(child,color)

var paint_mats := {}

func _paint_mat(color: Color) -> StandardMaterial3D:
	# v0.30: glossy car paint that reflects the sky (instead of flat matt colour).
	var key := color.to_html(false)
	if not paint_mats.has(key):
		var m := StandardMaterial3D.new()
		m.albedo_color = color
		m.metallic = 0.45
		m.roughness = 0.28
		m.metallic_specular = 0.7
		paint_mats[key] = m
	return paint_mats[key]

func _online_update_peers(delta: float) -> void:
	if online_peers.is_empty():
		return
	var now := Time.get_ticks_msec()/1000.0
	var gone: Array = []
	for id in online_peers:
		var peer: Dictionary = online_peers[id]
		if now-float(peer["seen"]) > ONLINE_TIMEOUT:
			gone.append(id)
			continue
		var node: Node3D = peer["node"]
		var target: Vector3 = peer["target"]
		var pseat := int(peer.get("seat",-1))
		if pseat >= 0 and not peer["driving"]:
			# Seated players are drawn in their chair.
			var st: Dictionary = hub_seats[pseat]
			node.position = st["pos"]
			node.rotation.y = float(st["face"])
			_sit_pose(peer.get("person",{}),float(st["h"]),0.0)
			peer["sat"] = true
			(peer["car"] as Node3D).visible = false
			(peer["foot"] as Node3D).visible = true
			continue
		if peer.get("sat",false):
			peer["sat"] = false
			_pose_person(peer.get("person",{}),0.0,0.0)
		if node.position.distance_to(target) > 25.0:
			node.position = target
		else:
			node.position = node.position.lerp(target,minf(1.0,delta*8.0))
		node.rotation.y = lerp_angle(node.rotation.y,float(peer["yaw"]),minf(1.0,delta*8.0))
		if not peer["driving"]:
			# v0.36.1: other players walk with their legs instead of gliding, and stand on raised floors.
			var pp: Dictionary = peer.get("person",{})
			if not pp.is_empty():
				var prev: Vector3 = peer.get("prev",node.position)
				var spd := Vector2(node.position.x-prev.x,node.position.z-prev.z).length()/maxf(delta,0.001)
				peer["prev"] = node.position
				peer["spd"] = lerpf(float(peer.get("spd",0.0)),minf(spd,8.0),minf(1.0,delta*6.0))
				var sp := float(peer["spd"])
				peer["phase"] = float(peer.get("phase",0.0))+delta*sp*6.2
				peer["lt"] = float(peer.get("lt",0.0))-delta
				if float(peer["lt"]) <= 0.0:
					peer["lt"] = 0.3
					_person_lift(pp)
				if not hub_emotes.any(func(e): return e["person"] == pp):
					_pose_person(pp,float(peer["phase"]),clampf(sp/1.6,0.0,1.35) if sp > 0.3 else 0.0)
		(peer["car"] as Node3D).visible = peer["driving"]
		(peer["foot"] as Node3D).visible = not peer["driving"]
		var plab: Label3D = peer["label"]
		plab.position.y = 2.8 if peer["driving"] else 1.2
		# v0.33.4: a player standing right at or behind your camera would get a giant name
		# smeared across the screen; hide the tag until they are in front of you.
		if camera != null:
			var lp := plab.global_position
			plab.visible = not camera.is_position_behind(lp) and camera.global_position.distance_to(lp) > 2.5
		var role := int(peer["role"])
		var cop := role == 2
		var flash := int(clock*6.0) % 2 == 0
		(peer["red"] as Node3D).visible = cop and flash
		(peer["blue"] as Node3D).visible = cop and not flash
		var key := "%d|%d|%s|%d|%d|%s" % [role,int(peer["lvl"]),_social_tag(peer),int(peer.get("at",-1)),int(peer.get("wr",0)),str(peer.get("we",false))]
		if key != str(peer["shown"]):
			peer["shown"] = key
			var tag := String(peer["name"])
			if int(peer.get("wr",-1)) >= 0:
				tag += " · "+WorldBiosphere.RANKS[int(peer.wr)]
			if peer.get("we",false):
				tag += " · World Explorer"
			var lab: Label3D = peer["label"]
			# v0.33.7: short tags (name and level, ★ for friends); crew, hearts and diamonds are in PLAYERS.
			lab.text = "%s · %d" % [tag,int(peer["lvl"])]+(" ★" if friends.has(String(peer.get("id",""))) else "")+("" if role == 0 else (" · THIEF" if role == 1 else " · POLICE"))
			lab.modulate = Color("ffb020") if role == 1 else (Color("9cc4ff") if role == 2 else _tier_color(int(peer.get("at",-1))))
	for id in gone:
		_announce_leave(String(online_peers[id].get("name","")))
		(online_peers[id]["node"] as Node3D).queue_free()
		online_peers.erase(id)
	if not gone.is_empty():
		_online_refresh_button()

func _online_clear_peers() -> void:
	for id in online_peers:
		(online_peers[id]["node"] as Node3D).queue_free()
	online_peers.clear()

func _online_refresh_button() -> void:
	if online_button == null:
		return
	if not online_on:
		online_button.text = "Online: OFF"
	elif online_state < 3:
		online_button.text = "Online: ..."
	else:
		online_button.text = "Online: %d" % (online_peers.size()+1)

