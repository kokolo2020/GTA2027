	var stats := _car_stats(garage_view)
	tune_title.text = "TUNE  %s" % spec["name"]
	tune_info.text = "Top speed %d km/h   Pickup %.1f   Handling %.1f\nYour cash: $%d" % [int(stats.x*3.6),stats.y,stats.z,cash]
