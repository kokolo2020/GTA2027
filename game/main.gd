func _web_perf_setup() -> void:
	if "--bench" in OS.get_cmdline_user_args():
		# Desktop check: average frame rate over 8 seconds of normal play, then quit.
		var at := OS.get_environment("HC_BENCH_AT")
		if at != "":
			# Developer: stand somewhere else for the benchmark ("x,z,yaw").
			var v := at.split_floats(",")
			get_tree().create_timer(1.5).timeout.connect(func():
				if crate_open:
					crate_open = false
					if crate_root != null:
						crate_root.hide()
				paused = false
				menu.hide()
				driving = false
				player.position = Vector3(v[0],0.9,v[1])
				player.rotation.y = v[2] if v.size() > 2 else 0.0
				car.position = Vector3(v[0]+4.0,0.8,v[1]))
		DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
		Engine.max_fps = 0
		get_tree().create_timer(4.0).timeout.connect(func():
			var f0 := Engine.get_process_frames()
			var t0 := Time.get_ticks_msec()
			get_tree().create_timer(8.0).timeout.connect(func():
				print("HC_BENCH fps=%.1f lite=%s scale=%.2f draws=%d prims=%d objs=%d proc_ms=%.2f phys_ms=%.2f nodes=%d at=%s" % [float(Engine.get_process_frames()-f0)*1000.0/float(Time.get_ticks_msec()-t0),str(web_lite),get_viewport().scaling_3d_scale,
					int(Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME)),int(Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME)),int(Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME)),
					Performance.get_monitor(Performance.TIME_PROCESS)*1000.0,Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS)*1000.0,int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT)),str(player.position.round())])
				get_tree().quit()))
	web_lite = OS.has_feature("android") or OS.has_feature("web") or "--web-lite" in OS.get_cmdline_user_args()
	if not web_lite:
		return
	if sun_light != null:
		# One shadow split and a shorter shadow range: much cheaper, still has shadows near you.
		sun_light.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL
		sun_light.directional_shadow_max_distance = 55.0
	RenderingServer.directional_shadow_atlas_set_size(2048,true)
	get_viewport().size_changed.connect(_web_scale)
	_web_scale()
	var show_fps := "--web-lite" in OS.get_cmdline_user_args()
	if OS.has_feature("web"):
		var search = JavaScriptBridge.eval("window.location.search",true)
		show_fps = typeof(search) == TYPE_STRING and String(search).contains("fps=1")
	if show_fps:
		fps_label = Label.new()
		fps_label.add_theme_font_size_override("font_size",18)
		fps_label.add_theme_color_override("font_color",Color("9cff9c"))
		fps_label.add_theme_color_override("font_outline_color",Color.BLACK)
		fps_label.add_theme_constant_override("outline_size",6)
		fps_label.position = Vector2(8,4)
		fps_label.z_index = 100
		var layer := CanvasLayer.new()
		layer.layer = 100
		add_child(layer)
		layer.add_child(fps_label)

func _web_scale() -> void:
	# Draw the 3D world at about 1.1 million pixels (menus and text stay sharp).
	var vp := get_viewport()
	var px := float(vp.get_visible_rect().size.x*vp.get_visible_rect().size.y)
	var real := Vector2(get_window().size)
	if real.x*real.y > 0.0:
		px = real.x*real.y
	vp.scaling_3d_mode = Viewport.SCALING_3D_MODE_BILINEAR
	vp.scaling_3d_scale = clampf(sqrt(WEB_3D_PIXELS/maxf(px,1.0)),0.5,1.0)

func _web_fps_tick() -> void:
	if fps_label != null:
		fps_label.text = "%d fps  ·  3D %d%%" % [Engine.get_frames_per_second(),int(get_viewport().scaling_3d_scale*100.0)]
