	touch_buttons.append(b)
	return b

func _qr_layout() -> void:
	if qr_big == null:
		return
	var view := get_viewport().get_visible_rect().size
	qr_big.position = (view-qr_big.size)/2.0

func _smoke_qr() -> void:
