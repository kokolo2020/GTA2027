	var a := ["Swift","Lucky","Harbor","Neon","Sunny","Turbo","Misty","Rocket","Coral","Pixel"]
	var b := ["Fox","Racer","Gull","Comet","Tiger","Otter","Rider","Wave","Star","Panda"]
	nick_edit.text = "%s%s%d" % [a[randi() % a.size()],b[randi() % b.size()],randi() % 90+10]
