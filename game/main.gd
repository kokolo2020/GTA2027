func _build_home_panels(root: Control) -> void:
	home_panel = PanelContainer.new()
	home_panel.add_theme_stylebox_override("panel",_panel(Color(0.06,0.11,0.16,0.97),26))
	home_panel.custom_minimum_size = Vector2(820,0)
