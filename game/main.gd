func _toggle_streamer() -> void:
	streamer_on = not streamer_on
	if paused:
		_toggle_menu()
	if not streamer_on:
		for c in st_dim:
			if is_instance_valid(c):
				(c as CanvasItem).modulate.a = 1.0
		# v0.52.1: everything goes back where it was, with its own visibility untouched.
		_st_restore()
	else:
		st_run_was = [run_button.visible,run_button.position] if run_button != null else []
		_st_hide_tick()
	st_fetch_t = 0.0
	_show_toast("Streamer mode ON: a clean screen with a join code for your viewers. Tap ≡ on the join card for the Menu." if streamer_on else "Streamer mode off.")

func _streamer_badge_tap() -> void:
	if not paused:
		_toggle_menu()

func _streamer_tick(delta: float) -> void:
	if st_root == null:
		return
	st_root.visible = streamer_on and not paused
	if not streamer_on:
		# Self-healing: however streamer mode was switched off, nothing stays hidden.
		if st_hold != null and st_hold.get_child_count() > 0:
			_st_restore()
		return
	# v0.52.1: everything but the join card, the play controls, quick chat and the step bars goes
	# into a hidden holder (see _st_hide_tick); the controls stay fully visible.
	_st_hide_tick()
	if paused:
		return
	var view := get_viewport().get_visible_rect().size
	var n := (online_peers.size()+1) if online_on else maxi(_watch_count(),1)
	var t := "● LIVE  ·  %d ONLINE" % n
	if st_badge.text != t:
		st_badge.text = t
	st_badge.size = Vector2(0,0)
	st_badge.position = Vector2(18,18)
	st_badge.modulate.a = 0.75+0.25*sin(clock*3.0)
	st_qr.reset_size()
	st_qr.position = Vector2(18,18)     # v0.52.1: top-left corner (the LIVE badge is hidden)
	st_menu_dot.size = st_menu_dot.custom_minimum_size
	st_menu_dot.position = st_qr.position+Vector2(st_qr.size.x-st_menu_dot.size.x*0.6,-st_menu_dot.size.y*0.4)
	var nv := _viewer_count()
	var vt := "🎮 %d %s playing now!" % [nv,"viewer" if nv == 1 else "viewers"]
	if st_viewers.text != vt:
		st_viewers.text = vt
	st_flash = maxf(0.0,st_flash-delta)
	var pulse := sin(st_flash*18.0)*0.5+0.5 if st_flash > 0.0 else 0.0
	st_viewers.reset_size()
	st_viewers.pivot_offset = st_viewers.size/2.0
	st_viewers.scale = Vector2.ONE*(1.0+0.12*pulse)
	st_viewers.self_modulate = Color(1,1,1).lerp(Color("ffe36b"),pulse)
	st_viewers.position = Vector2(18,st_qr.position.y+st_qr.size.y+12.0)
	var rows := _ds_sorted(0)
	var line := "HARBOR CITY"
	if not rows.is_empty():
		var top: Dictionary = rows[0]
		line += "   ★ Top: %s Lv %d" % [_online_clean_name(String(top.get("name",""))).substr(0,12),int(top.get("level",1))]
		var rich: Dictionary = _ds_sorted(1)[0]
		line += "   ·   Richest: %s %s" % [_online_clean_name(String(rich.get("name",""))).substr(0,12),_money(int(rich.get("cash",0)))]
	st_top.text = line
	st_top.size = Vector2(0,0)
	_hud_top_stack()     # v0.51.3: in the top column, under the quest and chapter bars
	# Keep the leaderboard fresh while streaming, wherever you are.
	if "--smoke-test" in OS.get_cmdline_user_args() or ds_get == null:
		return
	st_fetch_t -= delta
	if st_fetch_t <= 0.0 and ds_get.get_http_client_status() == HTTPClient.STATUS_DISCONNECTED and _online_load_config():
		st_fetch_t = 45.0
		ds_get.request(_lb_url("leaderboard?select=name,level,xp,cash,ach,kind&order=level.desc,xp.desc&limit=50"),_lb_headers())

# ---------- v0.34.5: a parked car drives itself home after 2 minutes ----------
# So it never blocks a street, pavement or doorway. CALL CAR brings it straight back.
const CAR_PARK_TIME := 120.0
var car_idle := 0.0
var car_gone := false

func _car_away() -> void:
	car_gone = true
	car.visible = false
	(car.get_child(0) as CollisionShape3D).set_deferred("disabled",true)
	car.velocity = Vector3.ZERO
	car_speed = 0.0

func _car_back() -> void:
	if not car_gone:
		return
	car_gone = false
	car.visible = true
	(car.get_child(0) as CollisionShape3D).set_deferred("disabled",false)

func _car_park_tick(delta: float) -> void:
	if car == null or player == null:
		return
	if driving or race_car or paused:
		car_idle = 0.0
		if driving:
			_car_back()
		return
	if car_gone:
		return
	car_idle += delta
	if car_idle >= CAR_PARK_TIME:
		car_idle = 0.0
		_car_away()
		_show_toast("Your car went home so it won't block the street. Tap CALL CAR any time.")
		_refresh_hud()

