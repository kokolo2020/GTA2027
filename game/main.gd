func _try_model(path: String) -> Node3D:
	if not ResourceLoader.exists(path):
		return null
	var res = load(path)
	if res is PackedScene:
		var inst := (res as PackedScene).instantiate() as Node3D
		_realify(inst)
		if path.begins_with("res://models/car_"):
			_car_underglow(inst)
		return inst
	return null

# ---------- v0.14.0: Blender-made people (player, pedestrians, online players on foot) ----------
func _make_person(parent: Node3D, variant: int, colors: Dictionary, tint := false) -> Dictionary:
	# v0.35: rigged, animated people (Kenney CC0 body + Harbor City animations) when the model is there.
	if not kperson_tried:
		kperson_tried = true
		# v0.36.1: back to the original Harbor City people (person_N.glb) by request. The animated
		# Kenney people stay in the project; set USE_KPERSON to bring them back.
		if USE_KPERSON and ResourceLoader.exists(KPERSON_PATH):
			kperson_scene = load(KPERSON_PATH) as PackedScene
	if kperson_scene != null:
		return _make_kperson(parent,variant,colors,tint)
	var model := _try_model("res://models/person_%d.glb" % variant)
	if model == null:
		return {}
	parent.add_child(model)
	var mats := {}
	var stack: Array[Node] = [model]
	while stack.size() > 0:
		var n: Node = stack.pop_back()
		stack.append_array(n.get_children())
		if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
			var mi := n as MeshInstance3D
			for surface in mi.mesh.get_surface_count():
				var src := mi.mesh.surface_get_material(surface)
				var key := src.resource_name if src != null else ""
				if not colors.has(key):
					continue
				if not mats.has(key):
					var m := StandardMaterial3D.new()
					m.albedo_color = colors[key]
					m.roughness = 0.75
					mats[key] = m
				mi.set_surface_override_material(surface,mats[key])
	var limbs := {}
	for part in ["ArmL","ArmR","LegL","LegR","Head","ShinL","ShinR","ForeArmL","ForeArmR"]:
		limbs[part] = model.find_child(part,true,false)
	var pp := {"root":model,"mats":mats,"limbs":limbs}
	# v0.40: hair, clothes and accessories are pieces hung on the body. Players get their own look
	# later; everyone else in the city gets a random everyday outfit from their seed.
	_person_index(pp,model)
	var L := _npc_look(npc_seq,colors,variant)
	if tint:
		for k in ["t","p","sh","a","f","b"]:
			L[k] = 0
		L["h"] = variant
	else:
		pp["npc"] = true
		npc_seq += 1
	_dress(pp,L)
	return pp

const KPERSON_PATH := "res://models/kperson.glb"
const USE_KPERSON := false
# Skins 0/1 are the plain outfits the game recolours (shirt, trousers, shoes, skin tone); the rest keep their look.
const KSKINS := ["humanMaleAT","humanFemaleAT","skaterMaleA","skaterFemaleA","cyborgFemaleA","criminalMaleA","survivorMaleB","survivorFemaleA"]
const KIDLES := ["Idle","Look","Talk","Idle","Phone","Sip","Look","Talk"]
# v0.35.1: adult proportions (longer legs, arms and torso, smaller head); numbers printed by
# blender-src/make_kenney_people.py as "FIT".
const K_HAT_SCALE := 1.15     # hats and head gear were sized for the old blocky head
const K_HEAD_Y := 1.53        # centre of the head above the feet
const K_HIP := 0.70           # seat contact height when sitting
const K_BACK_Y := 0.93        # where back gear (jetpack, wings) sits on the body
const K_HEAD_Z := -0.04       # head is slightly forward of the feet
const K_SKIN_REF := Color("e8b896")
var kperson_scene: PackedScene
var kperson_tried := false
var kskin_tex := {}
var kanim_ready := false
var kpeople: Array = []
var kpeople_t := 0.0
var kpeople_frame := 0

var kskin_mat := {}
var kshader: Shader

func _kshader() -> Shader:
	if kshader == null:
		kshader = load("res://people.gdshader") as Shader
	return kshader

# Copy the outfit colours (set on the plain "mats") onto the body shader when they change.
func _ksync(person: Dictionary) -> void:
	var mats: Dictionary = person["mats"]
	var cols: Array = []
	for key in ["Skin","Shirt","Pants","Shoes"]:
		cols.append((mats[key] as StandardMaterial3D).albedo_color)
	var key := str(cols)
	if key == String(person["synced"]):
		return
	person["synced"] = key
	var bm: ShaderMaterial = person["body_mat"]
	var names := ["c_skin","c_shirt","c_pants","c_shoes"]
	for k in 4:
		var c: Color = cols[k]
		bm.set_shader_parameter(names[k],Vector3(c.r,c.g,c.b))

func _kskin(skin_name: String) -> Texture2D:
	if not kskin_tex.has(skin_name):
		var path := "res://models/people/%s.png" % skin_name
		kskin_tex[skin_name] = load(path) if ResourceLoader.exists(path) else null
	return kskin_tex[skin_name]

func _make_kperson(parent: Node3D, variant: int, colors: Dictionary, tint: bool) -> Dictionary:
	var holder := Node3D.new()
	parent.add_child(holder)
	var model := kperson_scene.instantiate() as Node3D
	# The model faces +Z; Harbor City people face -Z like the old ones.
	model.rotation.y = PI
	holder.add_child(model)
	var h := absi(hash("%s|%s|%d" % [colors.get("Shirt",Color.WHITE),colors.get("Pants",Color.WHITE),variant]))
	var skin := (variant & 1) if tint else (h % 10)
	var tintable := tint or skin < 4
	var skin_name: String = KSKINS[skin & 1] if tintable else KSKINS[skin-2]
	# "mats" keeps one plain material per part so outfit code can keep setting colours; the body
	# itself draws with one shader material (one skinning pass), synced from these colours.
	var mats := {}
	for key in ["Skin","Shirt","Pants","Shoes"]:
		mats[key] = StandardMaterial3D.new()
	if tintable:
		(mats["Shirt"] as StandardMaterial3D).albedo_color = colors.get("Shirt",Color.WHITE)
		(mats["Pants"] as StandardMaterial3D).albedo_color = colors.get("Pants",Color.WHITE)
		var sh: Color = colors.get("Shoes",Color.WHITE)
		(mats["Shoes"] as StandardMaterial3D).albedo_color = Color.WHITE.lerp(sh,0.6)
		var sk: Color = colors.get("Skin",K_SKIN_REF)
		(mats["Skin"] as StandardMaterial3D).albedo_color = Color(minf(1.0,sk.r/K_SKIN_REF.r),minf(1.0,sk.g/K_SKIN_REF.g),minf(1.0,sk.b/K_SKIN_REF.b))
	var body_mat: ShaderMaterial
	if tintable:
		body_mat = ShaderMaterial.new()
		body_mat.shader = _kshader()
		body_mat.set_shader_parameter("skin_tex",_kskin(skin_name))
	else:
		# Fixed outfits share one material per skin.
		if not kskin_mat.has(skin_name):
			var sm := ShaderMaterial.new()
			sm.shader = _kshader()
			sm.set_shader_parameter("skin_tex",_kskin(skin_name))
			kskin_mat[skin_name] = sm
		body_mat = kskin_mat[skin_name]
	var ap: AnimationPlayer = null
	var stack: Array[Node] = [model]
	while stack.size() > 0:
		var n: Node = stack.pop_back()
		stack.append_array(n.get_children())
		if n is AnimationPlayer and ap == null:
			ap = n as AnimationPlayer
		if n is MeshInstance3D and (n as MeshInstance3D).mesh != null:
			var mi := n as MeshInstance3D
			mi.material_override = body_mat
	if ap != null and not kanim_ready:
		kanim_ready = true
		for an in ap.get_animation_list():
			if an != "Jump":
				ap.get_animation(an).loop_mode = Animation.LOOP_LINEAR
	var idle: String = "Idle" if tint else KIDLES[(h/10) % KIDLES.size()]
	var person := {"root":holder,"mats":mats,"limbs":{},"ap":ap,"idle":idle,"speed":0.85+0.3*float(h % 7)/6.0,"model":model,"body_mat":body_mat,"tint":tintable,"synced":""}
	if tintable:
		_ksync(person)
	if ap != null:
		ap.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
		ap.play(idle)
		ap.seek(float(h % 97)/97.0*ap.current_animation_length,true)
		ap.speed_scale = float(person["speed"])
		kpeople.append(person)
	return person

# Hat holder height for feet at feet_y (the hats were made for the old head, 0.555 m below its centre).
func _hat_y(feet_y: float) -> float:
	return feet_y+(K_HEAD_Y-K_HAT_SCALE*0.555 if kperson_scene != null else 0.99)

func _sit_drop() -> float:
	return K_HIP if kperson_scene != null else 0.86

func _kplay(person: Dictionary, anim: String, speed := -1.0) -> void:
	var ap: AnimationPlayer = person.get("ap")
	if ap == null or not is_instance_valid(ap):
		return
	if ap.current_animation != anim:
		ap.play(anim,0.2)
	ap.speed_scale = float(person["speed"]) if speed < 0.0 else speed

# Animated people update by distance: every frame within 14 m, every 2nd frame to 25 m, every 4th
# frame to 40 m, and not at all further away or when hidden (they're culled at 45-95 m anyway).
func _kpeople_tick(delta: float) -> void:
	kpeople_frame += 1
	kpeople_t -= delta
	var regrade := kpeople_t <= 0.0
	if regrade:
		kpeople_t = 0.4
	var cp := camera.global_position if camera != null else Vector3.ZERO
	for i in range(kpeople.size()-1,-1,-1):
		var p: Dictionary = kpeople[i]
		var root = p.get("root")
		if not is_instance_valid(root):
			kpeople.remove_at(i)
			continue
		if regrade:
			if p["tint"]:
				_ksync(p)
			var r3 := root as Node3D
			var d2 := r3.global_position.distance_squared_to(cp)
			p["lod"] = 0 if (not r3.is_visible_in_tree() or d2 > 1600.0) else (1 if d2 < 196.0 else (2 if d2 < 625.0 else 4))
		var lod := int(p.get("lod",1))
		if lod == 0:
			p["acc"] = 0.0
			continue
		var acc := float(p.get("acc",0.0))+delta
		if lod == 1 or (kpeople_frame+i) % lod == 0:
			(p["ap"] as AnimationPlayer).advance(acc)
			acc = 0.0
		p["acc"] = acc

func _pose_person(person: Dictionary, phase: float, amount: float) -> void:
	if person.is_empty():
		return
	person["sat"] = false
	if person.has("ap"):
		(person["root"] as Node3D).position.y = (person.get("base_y",0.0) as float)+float(person.get("lift",0.0))
		if person.get("busy",false):
			return
		if amount > 1.2:
			_kplay(person,"Run",1.0)
		elif amount > 0.05:
			_kplay(person,"Walk",clampf(amount*1.1,0.6,1.25))
		else:
			_kplay(person,String(person["idle"]))
		return
	_pose_limbs(person,phase,amount)

func _pose_limbs(person: Dictionary, phase: float, amount: float) -> void:
	# v0.36.1: a more natural walk and a living idle for the original Harbor City people.
	# Walk: legs swing from the hip with a bent knee through the swing and a soft bend on landing,
	# relaxed arms swing opposite the legs (a little away from the body, elbows bent more going
	# forward), the head stays level and turns slightly against the step, the body bobs and sways.
	# Idle (blends in as they slow down): breathing, a slow weight shift, gently moving arms and a
	# head that looks around now and then, each person on their own timing.
	var limbs: Dictionary = person["limbs"]
	var root: Node3D = person["root"]
	if not person.has("seed"):
		person["seed"] = float(root.get_instance_id() % 997)*0.731
	var sd: float = person["seed"]
	var amt := clampf(amount,0.0,1.5)
	var w := clampf(amt,0.0,1.0)
	var iw := 1.0-w
	var t := clock+sd
	var br := sin(t*1.7)
	var s := sin(phase)
	var k := 0
	for part in ["LegL","LegR"]:
		var leg: Node3D = limbs.get(part)
		if leg != null:
			var sgn := 1.0 if k == 0 else -1.0
			leg.rotation.x = sgn*s*0.55*amt+0.04*w+iw*0.025*sin(t*0.45+float(k)*PI)
		k += 1
	k = 0
	for part in ["ShinL","ShinR"]:
		var shin: Node3D = limbs.get(part)
		if shin != null:
			var ph := phase+(0.0 if k == 0 else PI)
			var lift := maxf(0.0,-sin(ph-0.9))
			var land := maxf(0.0,sin(ph+0.4))
			shin.rotation.x = -(0.07+1.05*lift+0.12*land)*amt-iw*(0.03+0.03*maxf(0.0,sin(t*0.45+float(k)*PI)))
		k += 1
	k = 0
	for part in ["ArmL","ArmR"]:
		var arm: Node3D = limbs.get(part)
		if arm != null:
			var sgn := -1.0 if k == 0 else 1.0
			var out := signf(arm.position.x) if absf(arm.position.x) > 0.001 else (1.0 if k == 1 else -1.0)
			arm.rotation.x = sgn*s*0.42*amt+0.06*w+iw*(0.035*sin(t*0.9+float(k)))
			arm.rotation.z = out*(0.085+0.02*w+0.012*br*iw)
		k += 1
	k = 0
	for part in ["ForeArmL","ForeArmR"]:
		var fa: Node3D = limbs.get(part)
		if fa != null:
			var fwd := maxf(0.0,sin(phase+(PI if k == 0 else 0.0)))
			fa.rotation.x = 0.2+(0.18+0.5*fwd)*amt+iw*0.03*br
		k += 1
	var head: Node3D = limbs.get("Head")
	if head != null:
		var look := sin(t*0.21)*0.35*maxf(0.0,sin(t*0.13+1.0))
		head.rotation.y = -s*0.06*amt+iw*look
		head.rotation.x = 0.03*absf(s)*amt+iw*0.02*br
	root.position.y = (person.get("base_y",0.0) as float)+float(person.get("lift",0.0))+absf(cos(phase))*0.03*amt+iw*0.004*br
	root.rotation.z = s*0.03*amt+iw*0.018*sin(t*0.45)

var life_i := 0
var life_snapped := false
var player_lift_t := 0.0

func _person_lift(pp: Dictionary) -> void:
	# Raise someone whose body follows physics (you, other players) onto raised floors that have no
	# collider, so their shoes sit on the paving instead of in it.
	if pp.is_empty():
		return
	var r: Node3D = pp["root"]
	if not is_instance_valid(r) or not r.is_inside_tree():
		return
	var old := float(pp.get("lift",0.0))
	var feet := r.global_position.y-old
	var top := _floor_top(r.global_position.x,r.global_position.z,feet+0.4)
	pp["lift"] = clampf(top-feet,0.0,0.35) if top != -INF else 0.0

func _snap_crowd_feet() -> void:
	# Once, after the world's colliders exist: lift standing crowds (Food Court, Harbor Commons,
	# hub, people at spots) onto the real ground under them.
	for lst in [fc_people,cm_people,bio_people]:
		for pp in lst:
			if pp.is_empty() or bool(pp.get("sat",false)) or pp.has("walk"):
				continue
			var r: Node3D = pp["root"]
			var h := r.get_parent() as Node3D
			if h == null or not h.is_inside_tree():
				continue
			var gp := h.global_position
			var g := _ground_at(gp.x,gp.z,gp.y)
			if g > gp.y+0.005 and g < gp.y+0.45:
				h.global_position.y = g

func _people_life_tick() -> void:
	# v0.36.1: people standing around keep breathing and looking about (original people only).
	if not life_snapped and clock > 1.5:
		life_snapped = true
		_snap_crowd_feet()
	if not player_person.is_empty() and not driving:
		player_lift_t -= get_process_delta_time()
		if player_lift_t <= 0.0:
			player_lift_t = 0.25
			_person_lift(player_person)
	if kperson_scene != null or paused:
		return
	var cam := get_viewport().get_camera_3d()
	if cam == null:
		return
	var cp := cam.global_position
	var busy := {}
	for e in hub_emotes:
		var r = (e["person"] as Dictionary).get("root")
		if is_instance_valid(r):
			busy[r] = true
	life_i += 1
	var lists: Array = [fc_people,cm_people,bio_people]
	var n := 0
	for lst in lists:
		for pp in lst:
			n += 1
			if (n+life_i) % 2 == 0:
				continue
			_life_one(pp,cp,busy)
	for p in peds:
		if bool(p.get("idle",false)):
			n += 1
			if (n+life_i) % 2 == 0:
				continue
			_life_one(p["person"],cp,busy)

func _life_one(pp: Dictionary, cp: Vector3, busy: Dictionary) -> void:
	if pp.is_empty() or bool(pp.get("sat",false)) or pp.has("ap") or pp.has("walk"):
		return
	var r: Node3D = pp["root"]
	if not is_instance_valid(r) or busy.has(r) or not r.is_visible_in_tree():
		return
	if r.global_position.distance_squared_to(cp) > 35.0*35.0:
		return
	_pose_limbs(pp,0.0,0.0)

func _cull_person(node: Node, distance: float, shadows := false) -> void:
	if node is GeometryInstance3D:
		(node as GeometryInstance3D).visibility_range_end = distance
		if not shadows:
			(node as GeometryInstance3D).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	for child in node.get_children():
		_cull_person(child,distance,shadows)

func _recolor_car_model(node: Node) -> void:
	if node is MeshInstance3D:
		var mi := node as MeshInstance3D
		if mi.mesh != null:
			for surface in mi.mesh.get_surface_count():
				var m := mi.mesh.surface_get_material(surface)
				var mat_name := m.resource_name if m != null else ""
				if mat_name.begins_with("Body"):
					mi.set_surface_override_material(surface,car_body_mat)
				elif mat_name.begins_with("Cabin"):
					mi.set_surface_override_material(surface,car_roof_mat)
	for child in node.get_children():
		_recolor_car_model(child)

func _apply_car_model() -> void:
	if car_boxes == null:
		return
	if car_model != null and car_model_id == _model_key():
		_recolor_car_model(car_model)
		return
	if car_model != null:
		car.remove_child(car_model)
		car_model.free()
		car_model = null
	car_model_id = _model_key()
	var model := _try_model("res://models/car_%d.glb" % (4 if race_car else (int(CAREERS[career]["model"]) if career >= 0 else int(CARS[car_id].get("model",car_id)))))
	if model == null:
		car_boxes.visible = true
		return
	car.add_child(model)
	car_model = model
	car_boxes.visible = false
	_recolor_car_model(model)

func _landmark(path: String, pos: Vector3, hide_meshes: Array) -> bool:
	var model := _try_model(path)
	if model == null:
		return false
	model.position = pos
	add_child(model)
	for mesh in hide_meshes:
		(mesh as MeshInstance3D).visible = false
	return true

