const CH_ARRIVE := 28.0
var ch_idx := 0                    # current chapter (CHAPTERS.size() = all done), saved
var ch_step := 0                   # current step inside it, saved
var ch_chip: Button
var ch_fx_n := 0                 # celebrations played (for tests)
var ch_best := 0                   # v0.51.2: chapters ever finished (rewards are paid once), saved
var ch_confirm: HBoxContainer
var ch_panel: PanelContainer
var ch_list: Label
var ch_t := 0.0

func _ch_jobs() -> int:
	var n := 0
	for j in career_jobs:
		n += int(j)
	return n

func _ch_homes() -> int:
	var n := 0
	for i in 8:
		if homes_owned & (1 << i):
			n += 1
	return n

func _ch_step_text(s: Dictionary) -> String:
	match String(s["k"]):
		"go": return "Go to %s" % String(s["t"])
		"deliv": return "Complete %d deliveries (%d/%d)" % [int(s["n"]),mini(deliveries,int(s["n"])),int(s["n"])]
		"cars": return "Own %d cars (%d/%d)" % [int(s["n"]),mini(_owned_count(),int(s["n"])),int(s["n"])]
		"trials": return "Clear %d time trials (%d/%d)" % [int(s["n"]),mini(_trial_count(),int(s["n"])),int(s["n"])]
		"lvl": return "Reach level %d (you are %d)" % [int(s["n"]),_level()]
		"jobs": return "Finish %d career jobs (%d/%d)" % [int(s["n"]),mini(_ch_jobs(),int(s["n"])),int(s["n"])]
		"home": return "Buy a home (Menu > ME > My Home)"
	return ""

func _ch_step_done(s: Dictionary) -> bool:
	match String(s["k"]):
		"go":
			var me: Node3D = car if driving else player
			var p: Vector3 = s["p"]
			return Vector2(me.position.x-p.x,me.position.z-p.z).length() < CH_ARRIVE
		"deliv": return deliveries >= int(s["n"])
		"cars": return _owned_count() >= int(s["n"])
		"trials": return _trial_count() >= int(s["n"])
		"lvl": return _level() >= int(s["n"])
		"jobs": return _ch_jobs() >= int(s["n"])
		"home": return _ch_homes() >= int(s["n"])
	return false

func _ch_target() -> Variant:
	# Where the guide arrow points for the chapter (lower priority than Directions, careers and quests).
	if ch_idx >= CHAPTERS.size():
		return null
	var steps: Array = CHAPTERS[ch_idx]["steps"]
	if ch_step >= steps.size() or String(steps[ch_step]["k"]) != "go":
		return null
	return steps[ch_step]["p"]

func _ch_finish_chapter() -> void:
	var C: Dictionary = CHAPTERS[ch_idx]
	# v0.51.2: after Restart chapters, a chapter finished before celebrates again but pays nothing.
	var paid := ch_idx >= ch_best
	if paid:
		cash += int(C["pay"])
		if not legacy_rules:
			bonus_xp += int(C["xp"])
	var nxt := ""
	if ch_idx+1 < CHAPTERS.size():
		nxt = "  Next: %s." % String(CHAPTERS[ch_idx+1]["name"])
	else:
		nxt = "  You finished every chapter. You are a Harbor City legend!"
	var reward: String = "+%s  +%d XP" % [_money(int(C["pay"])),int(C["xp"])] if paid else "replayed"
	_show_toast("CHAPTER %d COMPLETE: %s  %s.%s" % [ch_idx+1,C["name"],reward,nxt])
	_level_up_fx(0,"CHAPTER %d COMPLETE!" % (ch_idx+1),"%s\n%s" % [C["name"],reward.replace("  "," · ")])
	ch_fx_n += 1
	ch_best = maxi(ch_best,ch_idx+1)
	ch_idx += 1
	ch_step = 0
	_save_progress()

func _chapters_tick(delta: float) -> void:
	if ch_chip == null or player == null:
		return
	ch_t -= delta
	if ch_t > 0.0:
		return
	ch_t = 0.25
	# Move through every step that is already done (several can finish at once).
	var guard := 0
	while ch_idx < CHAPTERS.size() and guard < 12:
		guard += 1
		var steps: Array = CHAPTERS[ch_idx]["steps"]
		if ch_step >= steps.size():
			_ch_finish_chapter()
			continue
		if _ch_step_done(steps[ch_step]):
			if String(steps[ch_step]["k"]) == "go":
				_show_toast("%s reached!" % String(steps[ch_step]["t"]))
			ch_step += 1
			# v0.51.1: a little celebration for every step (the last one gets the big one below).
			if ch_step < steps.size():
				_level_up_fx(0,"","",true)
				ch_fx_n += 1
			continue
		break
	var show := ch_idx < CHAPTERS.size() and not paused and not sky_riding and not bus_riding and not (lvl_root != null and lvl_root.visible) and career < 0
	ch_chip.visible = show
	if ch_idx >= CHAPTERS.size():
		return
	var s: Dictionary = (CHAPTERS[ch_idx]["steps"] as Array)[ch_step]
	if String(s["k"]) == "go":
		var p: Vector3 = s["p"]
		var me: Node3D = car if driving else player
		var d := Vector2(me.position.x-p.x,me.position.z-p.z).length()
		ch_chip.text = "  CH %d · %s  ➜ %s · %s  " % [ch_idx+1,CHAPTERS[ch_idx]["name"],s["t"],_dir_fmt(d)]
	else:
		ch_chip.text = "  CH %d · %s  ➜ %s  " % [ch_idx+1,CHAPTERS[ch_idx]["name"],_ch_step_text(s)]
	ch_chip.reset_size()
	_hud_top_stack()

func _hud_top_stack() -> void:
	# v0.51.2: the top of the screen is one column, top to bottom: the quest bar, the chapter bar
	# right under it, then the screen guide arrow (and the treasure banner if it is in the way).
	if ch_chip == null or hud_arrow == null or quest_bar == null:
		return
	var view := get_viewport().get_visible_rect().size
	var top := 18.0
	if quest_bar.is_visible_in_tree():
		top = quest_bar.position.y+quest_bar.get_combined_minimum_size().y+8.0
	if cj_bar != null and cj_bar.is_visible_in_tree():
		cj_bar.reset_size()
		cj_bar.position = Vector2((view.x-cj_bar.size.x)/2.0,top)
		top += cj_bar.size.y+8.0
	if ch_chip.visible:
		ch_chip.reset_size()
		ch_chip.global_position = Vector2((view.x-ch_chip.size.x)/2.0,top)
		top += ch_chip.size.y+8.0
	if st_top != null and st_root != null and st_top.is_visible_in_tree():
		var sz := st_top.get_combined_minimum_size()
		st_top.size = sz
		st_top.position = Vector2((view.x-sz.x)/2.0,top)
		top += sz.y+6.0
	var ax := view.x/2.0-70.0
	if treasure_label != null and treasure_label.is_visible_in_tree():
		var tl := treasure_label
		if ax+140.0 > tl.position.x and ax < tl.position.x+tl.size.x:
			top = maxf(top,tl.position.y+tl.size.y+4.0)
	# The arrow's circle starts 8 px into its box; keep the old resting place when the top is empty.
	hud_arrow.position = Vector2(ax,maxf(96.0,top-8.0))

func _build_chapters_ui(root: Control) -> void:
	ch_chip = _button("",_open_chapters)
	ch_chip.add_theme_font_size_override("font_size",17)
	ch_chip.add_theme_stylebox_override("normal",_panel(Color(0.3,0.16,0.06,0.92),18))
	ch_chip.custom_minimum_size = Vector2(0,42)
