	_sign("FUEL FARM",Vector3(-190,13,-540),Color("ffe0b8"),44)
	# Car park with rows of parked cars.
	var cars := {}
	var rng := RandomNumberGenerator.new()
	rng.seed = 7272
	for row in [-470.0,-482.0,-494.0]:
		var cx := -242.0
