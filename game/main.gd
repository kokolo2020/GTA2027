var step_sound: AudioStreamWAV

func _step_sound() -> AudioStreamWAV:
	# v0.51.1: a short bright two-note chime for each chapter step.
	if step_sound != null:
		return step_sound
	var sr := 22050
	var total := int(sr*0.6)
	var buf := PackedFloat32Array()
	buf.resize(total)
	for n in [[0.0,79.0],[0.11,86.0]]:
		var start := int(float(n[0])*sr)
		var freq := 440.0*pow(2.0,(float(n[1])-69.0)/12.0)
		for i in range(total-start):
			var t := float(i)/sr
			var env := minf(1.0,t*80.0)*exp(-t*6.0)
			buf[start+i] += (sin(TAU*freq*t)+0.3*sin(TAU*freq*2.0*t))*env*0.24
	var data := PackedByteArray()
	data.resize(total*2)
	for i in total:
		data.encode_s16(i*2,int(clampf(buf[i],-1.0,1.0)*32000.0))
	step_sound = AudioStreamWAV.new()
	step_sound.format = AudioStreamWAV.FORMAT_16_BITS
	step_sound.mix_rate = sr
	step_sound.data = data
	return step_sound

# ---------------- v0.51.1: join and leave messages ----------------
# When a player comes online, everyone who is already playing sees it in the chat log and the feed,
# with a chime. The players you find when you join yourself are listed once, quietly, instead.
var online_joined_at := -100.0
var join_quiet_list: Array = []
var join_msgs := 0

func _announce_join(who: String, lvl: int) -> void:
	if who == "":
		return
	var now := Time.get_ticks_msec()/1000.0
	if now-online_joined_at < 4.0:
		# Already here when you came online.
		join_quiet_list.append(who)
		if join_quiet_list.size() == 1:
			get_tree().create_timer(4.0).timeout.connect(_announce_already_here)
		return
	join_msgs += 1
	if streamer_on:
		st_flash = 1.6      # v0.51.3: the viewer badge flashes with the join chime
	_chat_log_add("★","%s joined the game! (Lv %d)" % [who,clampi(lvl,1,40)],false)
	_feed_add_system("★ %s joined the game! Say hi with CHAT." % who)
	if fx_player != null and "--smoke-test" not in OS.get_cmdline_user_args():
		fx_player.stream = _step_sound()
		fx_player.play()

func _announce_already_here() -> void:
	if join_quiet_list.is_empty():
		return
	var n := join_quiet_list.size()
	var names := ", ".join(PackedStringArray(join_quiet_list.slice(0,3)))
	_chat_log_add("★","Playing now: %s%s" % [names," and %d more" % (n-3) if n > 3 else ""],false)
	join_quiet_list.clear()

func _announce_leave(who: String) -> void:
	if who == "" or not online_on:
		return
	_chat_log_add("★","%s left the game." % who,false)

# ---------------- v0.51.2: Photo mode (clean screenshots) ----------------
# A small camera button under the minimap hides everything on screen, leaving only the 3D view.
# The HUD layers are hidden as a whole (each element keeps its own visibility, so nothing stays
# hidden afterwards) and 3D overlays (name tags, player rings, speech bubbles, guide arrows) sit on
# their own render layer that the camera stops drawing. The game keeps running. In Photo mode you
# can still look around by dragging and walk with an invisible stick on the left half; a single
# tap anywhere, Back or Esc brings everything back.
const UI3D_LAYER := 1 << 19        # render layer 20: 3D things that are really part of the HUD
const SHOT_TAP_PX := 14.0
const SHOT_TAP_MS := 350
var shot_on := false
var shot_button: Button
var shot_hidden: Array = []        # the layers Photo mode hid, shown again on exit
var shot_cull := 0
var shot_press := {}               # touch index (or -10 for the mouse) -> [start position, start ms, moved]

func _ui3d(n: Node) -> void:
	if n is VisualInstance3D:
		(n as VisualInstance3D).layers = UI3D_LAYER
	for c in n.get_children():
		_ui3d(c)

func _shot_tick() -> void:
	if minimap == null:
		return
	if shot_button == null:
		shot_button = _button("",_shot_enter)
		shot_button.custom_minimum_size = Vector2(60,46)
		shot_button.tooltip_text = "Photo mode"
		shot_button.add_theme_stylebox_override("normal",_panel(Color(0.04,0.1,0.14,0.75),14))
		shot_button.add_theme_stylebox_override("hover",_panel(Color(0.06,0.16,0.22,0.85),14))
		var icon := Control.new()
		icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
		icon.set_anchors_preset(Control.PRESET_FULL_RECT)
		icon.draw.connect(_draw_shot_icon.bind(icon))
		shot_button.add_child(icon)
		minimap.get_parent().add_child(shot_button)
	shot_button.visible = not paused and not shot_on
	if not shot_button.visible:
		return
	shot_button.size = shot_button.custom_minimum_size
	var bw := shot_button.size.x
	if _clean_on():
		# Right-aligned under the minimap and the pills below it.
		var right := minimap.position.x+MINI_SIZE*CLEAN_MINI_SCALE
		var y := minimap.position.y+MINI_SIZE*CLEAN_MINI_SCALE+6.0
		for c in [online_pill,cash_pill]:
			if c != null and (c as Control).visible:
				y = maxf(y,(c as Control).position.y+(c as Control).size.y+6.0)
		shot_button.position = Vector2(right-bw,y)
	else:
		# Full screen HUD: the column under the minimap is taken, so it sits at the minimap's bottom left.
		shot_button.position = Vector2(minimap.position.x-bw-10.0,minimap.position.y+MINI_SIZE-shot_button.size.y)

func _draw_shot_icon(c: Control) -> void:
	# A little camera: body, viewfinder bump and lens.
	var mid := c.size/2.0
	var col := Color("dff3ff")
	c.draw_rect(Rect2(mid+Vector2(-15,-9),Vector2(30,20)),col)
	c.draw_rect(Rect2(mid+Vector2(-6,-13),Vector2(12,5)),col)
	c.draw_circle(mid+Vector2(0,1),7.0,Color("0e2230"))
	c.draw_circle(mid+Vector2(0,1),4.0,col)

func _shot_enter() -> void:
	if shot_on or paused:
		return
	shot_on = true
	shot_hidden.clear()
	for c in get_children():
		if (c is CanvasLayer or c is Control) and c.visible:
			c.visible = false
			shot_hidden.append(c)
	shot_cull = camera.cull_mask
	camera.cull_mask = shot_cull & ~UI3D_LAYER
	shot_press.clear()
	_shot_release_controls()

func _shot_exit() -> void:
	if not shot_on:
		return
	shot_on = false
	for c in shot_hidden:
		if is_instance_valid(c):
			c.visible = true
	shot_hidden.clear()
	camera.cull_mask = shot_cull | UI3D_LAYER
	shot_press.clear()
	_shot_release_controls()

func _shot_release_controls() -> void:
	stick = Vector2.ZERO
	touch_id = -1
	look_id = -1
	mouse_stick = false
	mouse_look = false

func _shot_stick_zone(point: Vector2) -> bool:
	return point.x < get_viewport().get_visible_rect().size.x*0.5

func _shot_input(event: InputEvent) -> void:
	get_viewport().set_input_as_handled()
	if event is InputEventKey and event.pressed and not event.echo and (event.keycode == KEY_ESCAPE or event.keycode == KEY_BACK):
		_shot_exit()
		return
	var id := -999
	var pos := Vector2.ZERO
	var pressed := false
	var is_press := false
	if event is InputEventScreenTouch:
		id = event.index
		pos = event.position
		pressed = event.pressed
		is_press = true
	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.device != InputEvent.DEVICE_ID_EMULATION:
		id = -10
		pos = event.position
		pressed = event.pressed
		is_press = true
	if is_press:
		if pressed:
			shot_press[id] = [pos,Time.get_ticks_msec(),false]
			if _shot_stick_zone(pos):
				if id == -10:
					mouse_stick = true
				else:
					touch_id = id
				touch_origin = pos
				stick = Vector2.ZERO
			elif eye_view or follow_view:
				if id == -10:
					mouse_look = true
				else:
					look_id = id
		else:
			var tap := false
			if shot_press.has(id):
				var st: Array = shot_press[id]
				tap = not bool(st[2]) and (pos-(st[0] as Vector2)).length() < SHOT_TAP_PX and Time.get_ticks_msec()-int(st[1]) < SHOT_TAP_MS
				shot_press.erase(id)
			if id == touch_id or (id == -10 and mouse_stick):
				touch_id = -1
				mouse_stick = false
				stick = Vector2.ZERO
			if id == look_id or (id == -10 and mouse_look):
				look_id = -1
				mouse_look = false
			if tap:
				if world_bio != null:
					world_bio.photo_capture()
				_shot_exit()
		return
	var did := -999
	var rel := Vector2.ZERO
	if event is InputEventScreenDrag:
		did = event.index
		pos = event.position
		rel = event.relative
	elif event is InputEventMouseMotion and event.device != InputEvent.DEVICE_ID_EMULATION:
		did = -10
		pos = event.position
		rel = event.relative
	if did == -999 or not shot_press.has(did):
		return
	var sp: Array = shot_press[did]
	if (pos-(sp[0] as Vector2)).length() >= SHOT_TAP_PX:
		sp[2] = true
	if did == touch_id or (did == -10 and mouse_stick):
		stick = ((pos-touch_origin)/65.0).limit_length()
	elif (did == look_id or (did == -10 and mouse_look)) and (eye_view or follow_view):
		_look(rel)

func _smoke_photo() -> void:
	# v0.51.2: Photo mode hides everything on screen, keeps the game running and brings it all back.
	var keep := [paused,walk_view,driving,player.position,player.rotation,camera.cull_mask]
	if paused:
		_toggle_menu()
	driving = false
	walk_view = 0
	_apply_view()
	_shot_tick()
	assert(shot_button != null and shot_button.visible and shot_button.get_parent() == minimap.get_parent(),"v0.51.2: camera button on the main screen")
	if _clean_on():
		assert(shot_button.position.y >= minimap.position.y+MINI_SIZE*CLEAN_MINI_SCALE and shot_button.position.x+shot_button.size.x <= minimap.position.x+MINI_SIZE*CLEAN_MINI_SCALE+1.0,"v0.51.2: camera button under the minimap")
	_my_tag_tick()
	_bubble(player,"Hi!",2.6)
	var bub: Node3D = hub_bubbles[hub_bubbles.size()-1]["label"]
	for n in [my_ring,my_tag,guide_arrow.get_child(0),goal_arrow.get_child(0).get_child(0),bub.get_child(0)]:
		if n is VisualInstance3D:
			assert((n as VisualInstance3D).layers == UI3D_LAYER,"v0.51.2: %s is drawn as part of the HUD" % n.name)
	var shown := []
	for c in get_children():
		if (c is CanvasLayer or c is Control) and c.visible:
			shown.append(c)
	assert(hud in shown,"v0.51.2: the HUD shows before Photo mode")
	var inner := {}
	for c in [quest_bar,ch_chip,chat_quick,minimap,joystick,action_button,qr_small,cash_pill,shot_button]:
		if c != null:
			inner[c] = (c as CanvasItem).visible
	shot_button.pressed.emit()
	assert(shot_on and camera.cull_mask & UI3D_LAYER == 0,"v0.51.2: Photo mode stops drawing tags, rings, bubbles and arrows")
	for c in get_children():
		if c is CanvasLayer or c is Control:
			assert(not c.visible,"v0.51.2: Photo mode hides %s" % c.name)
	assert(not get_tree().paused and not paused,"v0.51.2: the game keeps running in Photo mode")
	# Drag on the left half walks, drag on the right looks, neither leaves Photo mode.
	var view := get_viewport().get_visible_rect().size
	var t := InputEventScreenTouch.new()
	t.index = 0
	t.position = Vector2(view.x*0.2,view.y*0.5)
	t.pressed = true
	_input(t)
	var d := InputEventScreenDrag.new()
	d.index = 0
	d.position = t.position+Vector2(0,-60)
	d.relative = Vector2(0,-60)
	_input(d)
	assert(stick.y < -0.5,"v0.51.2: the invisible stick walks in Photo mode")
	t.position = d.position
	t.pressed = false
	_input(t)
	assert(shot_on and stick == Vector2.ZERO,"v0.51.2: walking does not leave Photo mode")
	t.index = 1
	t.position = Vector2(view.x*0.75,view.y*0.4)
	t.pressed = true
	_input(t)
	assert(look_id == 1,"v0.51.2: dragging on the right looks around")
	d.index = 1
	d.position = t.position+Vector2(80,0)
	d.relative = Vector2(80,0)
	_input(d)
	t.position = d.position
	t.pressed = false
	_input(t)
	assert(shot_on and look_id == -1,"v0.51.2: looking does not leave Photo mode")
	# A single tap anywhere brings everything back.
	t.index = 2
	t.position = Vector2(view.x*0.6,view.y*0.6)
	t.pressed = true
	_input(t)
	t.pressed = false
	_input(t)
	assert(not shot_on and camera.cull_mask & UI3D_LAYER != 0,"v0.51.2: a tap leaves Photo mode")
	for c in shown:
		assert(c.visible,"v0.51.2: %s is back after Photo mode" % c.name)
	for c in inner:
		assert((c as CanvasItem).visible == inner[c],"v0.51.2: %s keeps its own visibility" % c.name)
	# Esc (and Back) leave it too, without opening the menu.
	_shot_enter()
	var k := InputEventKey.new()
	k.keycode = KEY_ESCAPE
	k.pressed = true
	_input(k)
	assert(not shot_on and not paused and hud.visible,"v0.51.2: Esc leaves Photo mode without opening the menu")
	_shot_enter()
	_notification(NOTIFICATION_WM_GO_BACK_REQUEST)
	assert(not shot_on and not paused and hud.visible,"v0.51.2: Back leaves Photo mode")
	walk_view = keep[1]
	driving = keep[2]
	player.position = keep[3]
	player.rotation = keep[4]
	camera.cull_mask = keep[5] | UI3D_LAYER
	_apply_view()
	if keep[0] and not paused:
		_toggle_menu()

# ---------------- v0.51.3: stream joiners ----------------
# Viewers open kokolo2020.github.io/GTA2027/p (or scan the QR code), which goes to /play/?join=1.
# Such a visit goes online straight away, leaves the starter crate for later, and puts the new
# player next to whoever is streaming (the "st" flag in the position frame), with a welcome banner.
const SHORT_LINK := "kokolo2020.github.io/GTA2027/p"
const SHORT_LINK_CARD := "kokolo2020.github.io\n/GTA2027/p"
const SJ_WAIT := 12.0              # seconds to look for a streamer before a plain welcome
const SJ_CRATE_AFTER := 120.0      # the skipped starter crate opens after this much play
var stream_join := false
var sj_t := 0.0
var sj_landed := false
var sj_crate_later := false
var sj_banner: PanelContainer
var sj_title: Label
var sj_hint: Label
var sj_banner_t := 0.0
var sj_with := ""

var viewers_demo := -1             # developer screenshots only (HC_VIEWERS)

func _viewer_count() -> int:
	# Other players online right now (the streamer's viewers who joined).
	if viewers_demo >= 0:
		return viewers_demo
	return online_peers.size() if online_on else 0

func _stream_join_check() -> void:
	if not OS.has_feature("web"):
		return
	var search = JavaScriptBridge.eval("window.location.search",true)
	if typeof(search) == TYPE_STRING and String(search).contains("join=1"):
		_stream_join_start(true)

func _stream_join_start(connect := true) -> void:
	stream_join = true
	sj_t = 0.0
	sj_landed = false
	sj_crate_later = not crate_done
	# Online straight away, quietly (no nickname box in the way).
	if not online_on and _online_load_config() and not legacy_rules:
		online_pref = true
		online_on = true
		online_id = _uid()
		if online_name == "":
			online_name = "Driver%d" % (100+randi() % 900)
		online_retry = 0.0
		if connect:
			_online_connect()
		_online_refresh_button()

func _sj_streamer() -> Dictionary:
	# The streamer to join: of the players streaming right now, the one heard from most recently.
	var best := {}
	for id in online_peers:
		var peer: Dictionary = online_peers[id]
		if bool(peer.get("st",false)) and (best.is_empty() or float(peer.get("seen",0.0)) > float(best.get("seen",0.0))):
			best = peer
	return best

func _stream_join_tick(delta: float) -> void:
	if sj_banner != null and sj_banner.visible:
		sj_banner_t -= delta
		var view := get_viewport().get_visible_rect().size
		sj_banner.reset_size()
		sj_banner.position = Vector2((view.x-sj_banner.size.x)/2.0,view.y*0.3)
		sj_banner.modulate.a = clampf(sj_banner_t,0.0,1.0)
		if sj_banner_t <= 0.0 or paused:
			sj_banner.hide()
	if not stream_join:
		return
	sj_t += delta
	if not sj_landed:
		var st := _sj_streamer()
		if not st.is_empty():
			_stream_join_land(st)
		elif sj_t > SJ_WAIT:
			sj_landed = true
			_sj_welcome("")
	elif sj_crate_later and sj_t > SJ_CRATE_AFTER and not paused and not crate_open and not race_car and trial_active < 0 and chase_mode == 0 and not shot_on:
		sj_crate_later = false
		if not crate_done:
			_open_crate()

func _stream_join_land(st: Dictionary) -> void:
	sj_landed = true
	var at: Vector3 = (st["node"] as Node3D).position
	var spot := _offroad(at+Vector3(2.5,0,2.5))
	if driving:
		car.position = spot+Vector3(0,0.8,0)
		car.velocity = Vector3.ZERO
		car_speed = 0.0
	else:
		player.position = spot+Vector3(0,0.9,0)
		player.velocity = Vector3.ZERO
		# Face the streamer.
		player.rotation.y = atan2(-(at.x-spot.x),-(at.z-spot.z))
	_follow_camera(1.0)
	_sj_welcome(String(st.get("name","")))

func _sj_welcome(who: String) -> void:
	sj_with = who
	if sj_banner == null:
		sj_banner = PanelContainer.new()
		sj_banner.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var sb := _panel(Color(0.05,0.1,0.16,0.94),24)
		sb.border_color = Color("ffe36b")
		sb.set_border_width_all(3)
		sb.set_content_margin_all(22)
		sj_banner.add_theme_stylebox_override("panel",sb)
		hud.get_child(0).add_child(sj_banner)
		var col := VBoxContainer.new()
		col.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_theme_constant_override("separation",12)
		sj_banner.add_child(col)
		sj_title = _label("",32,Color("ffe36b"))
		sj_title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(sj_title)
		sj_hint = _label("",19,Color("dff3ff"))
		sj_hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		col.add_child(sj_hint)
	if who != "":
		sj_title.text = "Welcome to Harbor City!\nYou're playing with %s — say hi!" % who
	else:
		sj_title.text = "Welcome to Harbor City!\nYou're online — say hi with CHAT!"
	sj_hint.text = "Walk: drag on the left of the screen (or WASD / arrow keys)\nLook around: drag on the right   ·   Talk: CHAT"
	sj_banner_t = 10.0
	sj_banner.modulate.a = 1.0
