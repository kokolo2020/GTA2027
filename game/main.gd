func _smoke_stream_join() -> void:
	# v0.51.3: streamers are flagged, stream joiners land next to them, the viewer badge counts and flashes.
	var keep := [streamer_on,online_on,online_pref,online_id,online_name,crate_done,player.position,driving,stream_join,paused]
	if paused:
		_toggle_menu()
	driving = false
	streamer_on = true
	var f: Dictionary = _online_pos_frame()["payload"]["payload"]
	assert(int(f.get("st",0)) == 1,"v0.51.3: streamer mode is sent with your position")
	streamer_on = false
	f = _online_pos_frame()["payload"]["payload"]
	assert(int(f.get("st",1)) == 0,"v0.51.3: not streaming, no flag")
	# The short link works and is on the join card.
	var site := ProjectSettings.globalize_path("res://").path_join("../site")
	for page in ["p/index.html","join/index.html"]:
		var t := FileAccess.get_file_as_string(site.path_join(page))
		assert(t.contains("play/?join=1") and t.contains("location.replace"),"v0.51.3: %s redirects to the game with join=1" % page)
	var card_text := ""
	for n in st_qr.find_children("*","Label",true,false):
		card_text += (n as Label).text
	assert(card_text.replace("\n","").contains(SHORT_LINK),"v0.51.3: the short link is on the PLAY WITH ME card")
	# A viewer arrives: online at once, crate later, lands beside the streamer with a welcome.
	online_on = false
	crate_done = false
	var keep_legacy := legacy_rules
	legacy_rules = false     # the real game's rules, where joining goes online
	_stream_join_start(false)
	legacy_rules = keep_legacy
	assert(stream_join and not crate_open and sj_crate_later,"v0.51.3: stream joiners skip the starter crate for now")
	assert(online_on == _online_load_config(),"v0.51.3: stream joiners go online straight away")
	online_on = true
	online_joined_at = -100.0
	player.position = SPAWN_FOOD_COURT
	_online_peer_update({"i":"sjv1","n":"ViewerOne","x":-60.0,"y":0.9,"z":40.0,"r":0.0,"d":0,"l":3,"st":0})
	_online_peer_update({"i":"sjst","n":"MasterKolo","x":12.0,"y":0.9,"z":30.0,"r":0.0,"d":0,"l":20,"st":1})
	(online_peers["sjst"]["node"] as Node3D).position = Vector3(12.0,0.9,30.0)
	_stream_join_tick(0.1)
	assert(sj_landed and Vector2(player.position.x-12.0,player.position.z-30.0).length() < 8.0,"v0.51.3: the viewer lands next to the streamer (%s)" % str(player.position))
	assert(sj_banner.visible and sj_title.text.contains("You're playing with MasterKolo") and sj_hint.text.contains("WASD"),"v0.51.3: welcome banner names the streamer and shows how to move")
	# Later the starter crate still comes.
	sj_t = SJ_CRATE_AFTER+1.0
	_stream_join_tick(0.1)
	assert(crate_open and not sj_crate_later,"v0.51.3: the starter crate opens later")
	crate_open = false
	paused = false
	if crate_root != null:
		crate_root.hide()
	# Streamer screen: the viewer badge counts the others online and flashes when one joins.
	streamer_on = true
	_streamer_tick(0.016)
	assert(online_peers.size() >= 2 and st_viewers.visible and st_viewers.text == "🎮 %d viewers playing now!" % online_peers.size(),"v0.51.3: viewer badge counts (%s)" % st_viewers.text)
	var ok := ThemeDB.fallback_font.has_char("🎮".unicode_at(0))
	for fb in ThemeDB.fallback_font.fallbacks:
		ok = ok or (fb as Font).has_char("🎮".unicode_at(0))
	assert(ok,"v0.51.3: the game font can draw the badge symbol")
	_announce_join("ViewerTwo",2)
	assert(st_flash > 0.0,"v0.51.3: the badge flashes when someone joins")
	_streamer_tick(0.05)
	assert(st_viewers.scale.x > 1.0 or st_viewers.self_modulate != Color.WHITE,"v0.51.3: the flash shows")
	var br := Rect2(st_viewers.position,st_viewers.size*st_viewers.scale)
	assert(br.position.y >= st_qr.position.y+st_qr.size.y,"v0.51.3: the badge sits under the join card")
	# The leaders line no longer covers the chapter bar.
	if ch_chip.visible and st_top.visible:
		assert(not Rect2(st_top.position,st_top.size).intersects(Rect2(ch_chip.global_position,ch_chip.size)),"v0.51.3: the leaders line sits under the chapter bar")
	for id in ["sjv1","sjst"]:
		if online_peers.has(id):
			(online_peers[id]["node"] as Node3D).queue_free()
			online_peers.erase(id)
	sj_banner.hide()
	streamer_on = keep[0]
	online_on = keep[1]
	online_pref = keep[2]
	online_id = keep[3]
	online_name = keep[4]
	crate_done = keep[5]
	player.position = keep[6]
	driving = keep[7]
	stream_join = keep[8]
	st_flash = 0.0
	_streamer_tick(0.016)
	if keep[9] and not paused:
		_toggle_menu()

func _career_shot(what: String) -> void:
	# Developer-only (HC_CAREER=<i> HC_CJ=<moment>[:seconds]): one moment of a career job, for screenshots.
	var parts := what.split(":")
	var w := parts[0]
	var at_t := float(parts[1]) if parts.size() > 1 else 1.5
	var a: Vector3 = cj.get("a",player.position)
	driving = true
	player.hide()
	(player.get_child(0) as CollisionShape3D).disabled = true     # as when you get in the car
	var face := func(p: Vector3) -> void:
		car.rotation.y = atan2(-(p.x-car.position.x),-(p.z-car.position.z))
	var road_near := func(p: Vector3) -> Vector3:
		# Open pavement 5-8 m away (off the road, so passing traffic can't carry the car off).
		for r in [5.0,6.5,8.0]:
			for k in 16:
				var q: Vector3 = p+Vector3(sin(k*TAU/16.0),0,cos(k*TAU/16.0))*float(r)
				if not _on_road(q) and not _blocked_at(q+Vector3(0,1.0,0),2.2):
					return Vector3(q.x,0.8,q.z)
		return p+Vector3(-3.2,0.8,0)
	if not cs.is_empty() and w != "radio":
		_cs_skip()
	match w:
		"wait":
			car.position = a+Vector3(-14,0.8,16)
			face.call(a)
			cam_lock = false
		"pickup","mirror","dropoff","done":
			car.position = road_near.call(a)
			face.call(car.position+(car.position-a).cross(Vector3.UP))
			_career_tick(0.1)
			if w != "pickup" and w != "mirror":
				_cs_skip()
				var b: Vector3 = cj["b"]
				car.position = road_near.call(b)
				face.call(car.position+(car.position-b).cross(Vector3.UP))
				cj["fare"] = 64.0
				_career_tick(0.1)
				if w == "done":
					_cs_skip()
					cam_lock = false
		"load","unload":
			car.position = road_near.call(a)
			face.call(car.position+(car.position-a).cross(Vector3.UP))
			_career_tick(0.1)
			if w == "unload":
				_cs_skip()
				car.position = HOSPITAL_DROP+Vector3(0,0.8,0)
				face.call(HOSPITAL_DROP+Vector3(10,0,0))
				_career_tick(0.1)
		"arrest":
			car.position = a+Vector3(0,0.8,0)
			_career_tick(0.1)
			for u in chase_units:
				if not u["cop"]:
					(u["node"] as Node3D).global_position = car.global_position+(-car.global_basis.z)*9.0
					(u["node"] as Node3D).rotation.y = car.rotation.y
			_chase_end("Caught!",400)
		"spray","fireout":
			car.position = a+Vector3(-9,0.8,7)
			face.call(a)
			driving = false
			player.show()
			(player.get_child(0) as CollisionShape3D).disabled = false
			player.position = a+Vector3(-4.5,0.9,3.5)
			player.rotation.y = atan2(-(a.x-player.position.x),-(a.z-player.position.z))
			if not _fire_aimed():
				player.rotation.y += PI
			_career_tick(0.1)
			_career_tick(0.1)
			if w == "fireout":
				cj["hp"] = 0.01
				_career_tick(0.1)
			else:
				cj["hp"] = 0.55
				walk_view = 0
				_apply_view()
				cam_lock = false
	if not cs.is_empty():
		cs["t"] = at_t
		cs_freeze = true
	for i in 45:
		await get_tree().physics_frame

# ---------------- v0.52.1: streamer mode shows only what the stream needs ----------------
# The join card, the play controls (stick, action button, BOARD, RUN, camera), quick chat and the
# job/chapter step bars while they're active. Everything else is moved into a hidden holder (its own
# visibility untouched) and moved back when streamer mode ends, so nothing comes back wrong.
func _st_hide_tick() -> void:
	if hud == null:
		return
	var root: Control = hud.get_child(0)
	if st_hold == null:
		st_hold = Control.new()
		st_hold.name = "StreamerHidden"
		st_hold.mouse_filter = Control.MOUSE_FILTER_IGNORE
		st_hold.set_anchors_preset(Control.PRESET_FULL_RECT)
		st_hold.visible = false
		root.add_child(st_hold)
	var want := {}
	for nm in ST_HIDE:
		var c = get(nm)
		if c is Control and is_instance_valid(c):
			want[c] = true
	for c in want:
		var ctl := c as Control
		if ctl.get_parent() != st_hold:
			var par := ctl.get_parent()
			st_held[ctl] = [par,ctl.get_index(),st_held.size()]     # removal order, for an exact undo
			par.remove_child(ctl)
			st_hold.add_child(ctl)
	# Anything else that was built into the holder while it held the minimap (lazily made buttons)
	# goes straight back out.
	for c in st_hold.get_children():
		if not want.has(c):
			st_hold.remove_child(c)
			var back: Array = st_held.get(c,[root,-1])
			(back[0] as Node).add_child(c)
			st_held.erase(c)
	# RUN is part of the play controls here, even on the clean screen: above BOARD / the action button.
	if run_button != null and not driving:
		run_button.visible = true
		run_button.reset_size()
		var anchor: Control = board_button if board_button != null and board_button.is_visible_in_tree() else action_button
		run_button.position = anchor.position+Vector2(anchor.size.x-run_button.size.x,-run_button.size.y-12.0)

func _st_restore() -> void:
	if st_hold == null:
		return
	# Put them back in reverse removal order, each at the index it had, which undoes it exactly.
	var items: Array = []
	for c in st_hold.get_children():
		var back: Array = st_held.get(c,[hud.get_child(0),-1,-1])
		items.append([c,back[0],int(back[1]),int(back[2]) if back.size() > 2 else -1])
	items.sort_custom(func(a,b): return int(a[3]) > int(b[3]))
	for it in items:
		var c: Node = it[0]
		st_hold.remove_child(c)
		(it[1] as Node).add_child(c)
		if int(it[2]) >= 0 and int(it[2]) < (it[1] as Node).get_child_count():
			(it[1] as Node).move_child(c,int(it[2]))
	st_held.clear()
	if run_button != null and st_run_was.size() == 2:
		run_button.visible = bool(st_run_was[0])
		run_button.position = st_run_was[1]
	st_run_was = []

func _smoke_streamer_clean() -> void:
	# v0.52.1: streamer mode hides everything but the join card, controls, quick chat and step bars,
	# keeps the menu reachable, and brings it all back exactly.
	var keep := [streamer_on,paused,driving]
	if streamer_on:
		_toggle_streamer()
	if paused:
		_toggle_menu()
	driving = false
	_clean_hud_tick()
	_streamer_tick(0.016)
	_shot_tick()
	_chat_tick(0.0)
	var before := {}
	for nm in ST_HIDE+["joystick","action_button","board_button","run_button","shot_button","chat_quick","menu"]:
		var c = get(nm)
		if c is CanvasItem and is_instance_valid(c):
			before[nm] = [(c as CanvasItem).visible,(c as Node).get_parent(),(c as Node).get_index()]
	_toggle_streamer()
	_streamer_tick(0.016)
	assert(streamer_on and st_qr.is_visible_in_tree() and st_menu_dot.is_visible_in_tree(),"v0.52.1: the join card shows, with its menu button")
	for nm in ST_HIDE:
		var c = get(nm)
		if c is CanvasItem and is_instance_valid(c):
			assert(not (c as CanvasItem).is_visible_in_tree(),"v0.52.1: streamer mode hides %s" % nm)
	for nm in ["joystick","action_button","shot_button","run_button"]:
		assert((get(nm) as CanvasItem).is_visible_in_tree(),"v0.52.1: streamer mode keeps %s" % nm)
	assert(chat_quick.is_visible_in_tree() == (not web_build),"v0.52.1: quick chat stays (app)")
	assert(Rect2(run_button.position,run_button.size).intersects(Rect2(st_qr.position,st_qr.size)) == false,"v0.52.1: RUN sits with the controls, not on the card")
	# Step bars still show while a job or chapter step is active.
	assert(ch_chip.get_parent() != st_hold and (cj_bar == null or cj_bar.get_parent() != st_hold),"v0.52.1: step bars are never hidden by streamer mode")
	# A hidden button can't be tapped.
	assert(not minimap.is_visible_in_tree() and not quests_button.is_visible_in_tree(),"v0.52.1: hidden buttons are out of reach")
	# The menu is reachable from the card's corner.
	st_menu_dot.pressed.emit()
	assert(paused and menu.visible,"v0.52.1: the menu opens from the join card")
	_toggle_menu()
	_toggle_streamer()
	_clean_hud_tick()
	_streamer_tick(0.016)
	assert(not streamer_on and st_hold.get_child_count() == 0,"v0.52.1: streamer mode off empties the holder")
	for nm in before:
		var c: CanvasItem = get(nm)
		assert(c.visible == before[nm][0] and c.get_parent() == before[nm][1] and c.get_index() == int(before[nm][2]),"v0.52.1: %s is back exactly as before (vis %s/%s, parent %s/%s, index %d/%d)" % [nm,c.visible,before[nm][0],c.get_parent().name,(before[nm][1] as Node).name,c.get_index(),int(before[nm][2])])
	driving = keep[2]
	if keep[0] != streamer_on:
		_toggle_streamer()
	if keep[1] and not paused:
		_toggle_menu()


