	# Ground: forecourt, car park, apron, taxiway, runway.
	_box_batch(Color("9c9a92"),[[Vector3(40,0.02,-471.5),Vector3(240,0.06,17)],[Vector3(-172.5,0.02,-482),Vector3(155,0.06,36)]])
